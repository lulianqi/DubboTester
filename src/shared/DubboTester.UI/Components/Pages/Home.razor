    private static string HistoryTargetText(InvocationHistory item) =>
        item.Route == InvocationRoute.Registry
            ? $"注册目录 {(!string.IsNullOrWhiteSpace(item.RegistryRootPath) ? item.RegistryRootPath : "/")}"
            : $"{item.Host}:{item.Port}";

