    private async Task RestoreHomeRequestDraftAsync()
    {
        if (!IndexedDbAvailable) return;
        try
        {
            string? json = await JS.InvokeAsync<string?>("dubboTester.indexedDb.loadHomeRequestDraft");
            if (string.IsNullOrWhiteSpace(json)) return;

            HomeRequestDraft? draft = JsonSerializer.Deserialize<HomeRequestDraft>(json, StorageJsonOptions);
            InvocationInput input = draft?.Invocation ?? throw new JsonException("请求配置为空");
            if (!Enum.IsDefined(input.Route) || input.Port is < 1 or > 65535
                || input.ServiceName is null || input.MethodName is null || input.RegistryRootPath is null
                || input.Host is null || input.RequestJson is null || input.JavaParameterTypes is null
                || input.Version is null || input.Group is null || input.AttachmentsJson is null)
            {
                throw new JsonException("请求配置格式无效");
            }

            MethodSignatureItem? selected = draft.Signatures?.ElementAtOrDefault(draft.SelectedSignatureIndex);
            Signatures = draft.Signatures?.Where(signature => signature is not null
                && signature.ParameterTypes is not null && signature.ParameterTypes.All(type => type is not null)
                && signature.ServiceName == input.ServiceName.Trim()
                && signature.MethodName == input.MethodName.Trim()).ToList() ?? [];
            SelectedSignatureIndex = selected is null ? 0 : Math.Max(0, Signatures.IndexOf(selected));
            Input = input;
            SignatureReadFailed = draft.SignatureReadFailed;
            ParameterStructures = SelectedSignature is null ? [] : DubboTypeStructureBuilder.Build(SelectedSignature);
            LastSavedHomeDraftJson = CaptureHomeRequestDraftJson();
        }
        catch (Exception exception) when (exception is JSException or JsonException or ArgumentException or NotSupportedException)
        {
            Input = new InvocationInput();
            Signatures = [];
            ParameterStructures = [];
            SelectedSignatureIndex = 0;
            SignatureReadFailed = false;
            SetWarning($"读取上次请求配置失败，当前显示空白请求：{GetErrorMessage(exception)}");
        }
    }

    private string CaptureHomeRequestDraftJson() => JsonSerializer.Serialize(new HomeRequestDraft
    {
        Invocation = Input.Clone(),
        Signatures = Signatures.ToList(),
        SelectedSignatureIndex = SelectedSignatureIndex,
        SignatureReadFailed = SignatureReadFailed
    }, StorageJsonOptions);

    private async Task PersistHomeRequestDraftAsync()
    {
        if (!ClientStorageReady || !IndexedDbAvailable || IsDisposed) return;
        await HomeDraftSaveGate.WaitAsync();
        try
        {
            if (IsDisposed) return;
            string json = CaptureHomeRequestDraftJson();
            if (json == LastSavedHomeDraftJson) return;
            await JS.InvokeVoidAsync("dubboTester.indexedDb.saveHomeRequestDraft", json);
            LastSavedHomeDraftJson = json;
            HomeDraftSaveFailed = false;
        }
        catch (Exception exception) when (exception is JSException or JsonException or OperationCanceledException)
        {
            if (!HomeDraftSaveFailed && !IsDisposed)
            {
                SetWarning($"保存当前请求配置失败，刷新后可能无法恢复：{GetErrorMessage(exception)}");
            }
            HomeDraftSaveFailed = true;
        }
        finally
        {
            HomeDraftSaveGate.Release();
        }
    }

    private async Task PersistCurrentRequestDraftAsync()
    {
        string? key = CurrentRequestDraftKey();
        if (key is null) return;

        RequestDrafts[key] = Input.RequestJson;
        if (!IndexedDbAvailable) return;
        try
        {
            await JS.InvokeVoidAsync(
                "dubboTester.indexedDb.putRequestDraft",
                key,
                Input.RequestJson);
        }
        catch (JSException exception)
        {
            IndexedDbAvailable = false;
            ClientStorageLoadFailed = true;
            SetWarning($"请求参数草稿未能写入本地数据库，已保留在当前界面内存中：{GetErrorMessage(exception)}");
        }
    }

    private async Task RestoreCurrentRequestDraftAsync()
    {
        // A signature refresh must not overwrite text already entered by the user.
        if (!string.IsNullOrWhiteSpace(Input.RequestJson)) return;
        string? key = CurrentRequestDraftKey();
        if (key is null) return;

        if (RequestDrafts.TryGetValue(key, out string? requestJson))
        {
            Input.RequestJson = requestJson;
            return;
        }

        if (IndexedDbAvailable)
        {
            try
            {
                requestJson = await JS.InvokeAsync<string?>(
                    "dubboTester.indexedDb.getRequestDraft",
                    key);
                // The user can type or switch methods while storage is loading.
                if (key != CurrentRequestDraftKey() || !string.IsNullOrWhiteSpace(Input.RequestJson)) return;
                if (requestJson is not null)
                {
                    RequestDrafts[key] = requestJson;
                    Input.RequestJson = requestJson;
                    return;
                }
            }
            catch (JSException exception)
            {
                IndexedDbAvailable = false;
                ClientStorageLoadFailed = true;
                SetWarning($"读取请求参数草稿失败：{GetErrorMessage(exception)}");
            }
        }
    }

    private string? CurrentRequestDraftKey()
    {
        string serviceName = Input.ServiceName.Trim();
        string methodName = Input.MethodName.Trim();
        if (serviceName.Length == 0 || methodName.Length == 0) return null;

        string parameterTypes = SelectedSignature is not null
            ? string.Join(",", SelectedSignature.ParameterTypes)
            : Input.JavaParameterTypes.Trim();
        return string.Join(
            '\u001f',
            Settings.RegistryCacheAddress,
            Input.RegistryRootPath.Trim(),
            serviceName,
            methodName,
            parameterTypes,
            Input.Version.Trim(),
            Input.Group.Trim());
    }

    private async Task FormatRequest()
    {
        try
        {
            Input.RequestJson = JsonArgumentParser.FormatArguments(Input.RequestJson);
            await PersistCurrentRequestDraftAsync();
            SetNotice("请求 JSON 已格式化");
        }
        catch (Exception exception) { SetNotice($"JSON 格式错误：{exception.Message}", true); }
    }

    private IEnumerable<string> FilterMethods(IEnumerable<string> methods)
    {
        if (string.IsNullOrWhiteSpace(SearchText) || !Settings.HideUnmatched) return methods;
        StringComparison comparison = Settings.CaseSensitiveSearch ? StringComparison.Ordinal : StringComparison.OrdinalIgnoreCase;
        return methods.Where(method => method.Contains(SearchText, comparison));
    }

