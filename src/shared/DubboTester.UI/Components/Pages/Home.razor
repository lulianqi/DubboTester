    private async Task LoadHistoryPageAsync()
    {
        if (!IndexedDbAvailable) return;

        int loadVersion = ++HistoryLoadVersion;
        try
        {
            string? json = await JS.InvokeAsync<string?>(
                "dubboTester.indexedDb.loadHistoryPage",
                HistoryPageNumber,
                HistoryPageSize,
                HistorySearchText,
                FavoritesOnly);
            HistoryPagePayload page = string.IsNullOrWhiteSpace(json)
                ? new HistoryPagePayload()
                : JsonSerializer.Deserialize<HistoryPagePayload>(json, StorageJsonOptions)
                    ?? new HistoryPagePayload();
            if (loadVersion != HistoryLoadVersion) return;
            HistoryTotalCount = page.TotalCount;
            int pageCount = HistoryPageCount;
            if (HistoryPageNumber > pageCount)
            {
                HistoryPageNumber = pageCount;
                await LoadHistoryPageAsync();
                return;
            }
            History = page.Items;
            StateHasChanged();
        }
        catch (OperationCanceledException)
        {
            SetWarning("页面连接已中断，连接恢复后可重新读取调用历史");
        }
        catch (JSException exception)
        {
            SetWarning($"读取调用历史失败：{GetErrorMessage(exception)}");
        }
    }

    private async Task ChangeHistoryPageAsync(int pageNumber)
    {
        int target = Math.Clamp(pageNumber, 1, HistoryPageCount);
        if (target == HistoryPageNumber) return;
        CloseHistoryDetails();
        HistoryPageNumber = target;
        await LoadHistoryPageAsync();
    }

    private async Task<InvocationHistory> LoadFullHistoryAsync(InvocationHistory summary)
    {
        if (!IndexedDbAvailable) return summary;

        try
        {
            string? metadataJson = await JS.InvokeAsync<string?>(
                "dubboTester.indexedDb.getHistoryMetadata",
                summary.Id);
            InvocationHistory item = string.IsNullOrWhiteSpace(metadataJson)
                ? summary
                : JsonSerializer.Deserialize<InvocationHistory>(metadataJson, StorageJsonOptions)
                    ?? summary;
            item.RequestJson = await LoadHistoryFieldAsync(item.Id, "requestJson");
            item.AttachmentsJson = await LoadHistoryFieldAsync(item.Id, "attachmentsJson");
            item.Response = await LoadHistoryFieldAsync(item.Id, "response");
            return item;
        }
        catch (OperationCanceledException)
        {
            SetWarning("页面连接已中断，暂时无法读取历史详情");
            return summary;
        }
        catch (JSException exception)
        {
            SetWarning($"读取历史详情失败：{GetErrorMessage(exception)}");
            return summary;
        }
    }

    private async Task<string> LoadHistoryFieldAsync(string id, string fieldName)
    {
        const int chunkSize = 16_384;
        var builder = new System.Text.StringBuilder();
        while (true)
        {
            string chunk = await JS.InvokeAsync<string>(
                "dubboTester.indexedDb.getHistoryFieldChunk",
                id,
                fieldName,
                builder.Length,
                chunkSize);
            builder.Append(chunk);
            if (chunk.Length < chunkSize) return builder.ToString();
        }
    }

