    private async Task TestProviderAsync()
    {
        if (!IsDirectProviderRoute || IsProviderTesting) return;

        IsProviderTesting = true;
        ProviderTestSucceeded = null;
        SetNotice($"正在连接 Provider {Input.Host}:{Input.Port}…");
        StateHasChanged();
        await Task.Yield();

        try
        {
            await DubboSession.TestProviderAsync(Input.Host, Input.Port, Settings.RequestTimeoutMs);
            ProviderTestSucceeded = true;
            SetNotice($"Provider {Input.Host}:{Input.Port} TCP 连接成功");
        }
        catch (Exception exception)
        {
            ProviderTestSucceeded = false;
            SetNotice($"Provider 连接失败：{GetErrorMessage(exception)}", true);
        }
        finally
        {
            IsProviderTesting = false;
            StateHasChanged();
        }
    }

    private async Task InvokeAsync()
    {
        if (IsInvoking || IsProviderTesting) return;
        DateTimeOffset submittedAt = DateTimeOffset.Now;
        InvocationInput submittedInput = Input.Clone();
        long resultContextVersion = ResultContextVersion;
        IsInvoking = true;
        if (!KeepResultHistory) ClearResult();
        SetNotice($"正在调用 {Input.ServiceName}#{Input.MethodName}…");

        // Yield once after requesting a render so the busy state is visible before
        // persistence or the Dubbo invocation starts doing potentially blocking work.
        StateHasChanged();
        await Task.Yield();

        try
        {
            await PersistCurrentRequestDraftAsync();
            InvocationOutput output = await Session.InvokeAsync(Settings, submittedInput);
            string responseText = output.Success
                ? output.Content
                : output.Error ?? "Dubbo 请求失败，未返回错误详情。";
            if (KeepResultHistory || resultContextVersion == ResultContextVersion)
            {
                PresentResult(submittedAt, submittedInput, output, responseText);
            }
            SetNotice(output.Success ? $"调用成功，用时 {output.RequestElapsed} ms" : $"调用失败：{output.Error}", !output.Success);
            HistoryMutation historyMutation = AddHistory(output, responseText, submittedInput);
            await PersistHistoryMutationAsync(historyMutation);
        }
        catch (Exception exception)
        {
            string message = GetErrorMessage(exception);
            InvocationOutput output = new() { Success = false, Error = message };
            if (KeepResultHistory || resultContextVersion == ResultContextVersion)
            {
                PresentResult(submittedAt, submittedInput, output, message);
            }
            SetNotice($"调用失败：{message}", true);
            if (!string.IsNullOrWhiteSpace(submittedInput.ServiceName)
                && !string.IsNullOrWhiteSpace(submittedInput.MethodName))
            {
                HistoryMutation historyMutation = AddHistory(output, message, submittedInput);
                await PersistHistoryMutationAsync(historyMutation);
            }
        }
        finally { IsInvoking = false; }
    }

    private async Task OpenPressureTest()
    {
        if (IsInvoking) return;
        await PersistCurrentRequestDraftAsync();
        await PersistHomeRequestDraftAsync();
        PressureDraft.Capture(Settings, Input);
        Navigation.NavigateTo("/pressure-test");
    }

    private HistoryMutation AddHistory(InvocationOutput output, string responseText, InvocationInput submittedInput)
    {
        CloseHistoryDetails();
        var added = new InvocationHistory
        {
            Success = output.Success,
            Route = submittedInput.Route,
            RegistryRootPath = submittedInput.RegistryRootPath,
            ServiceName = submittedInput.ServiceName,
            MethodName = submittedInput.MethodName,
            Host = submittedInput.Host,
            Port = submittedInput.Port,
            RequestJson = submittedInput.RequestJson,
            JavaParameterTypes = submittedInput.JavaParameterTypes,
            Version = submittedInput.Version,
            Group = submittedInput.Group,
            AttachmentsJson = submittedInput.AttachmentsJson,
            Response = Settings.SaveResponseInHistory ? responseText : string.Empty,
            ElapsedMs = output.RequestElapsed
        };
        if (!IndexedDbAvailable)
        {
            History.Insert(0, added);
            HistoryRetentionPolicy.TrimToLimit(History, Math.Min(Settings.HistoryLimit, HistoryPageSize));
            HistoryTotalCount = History.Count;
        }
        return new HistoryMutation(added, []);
    }

    private async Task LoadHistoryAsync(InvocationHistory item)
    {
        CloseHistoryDetails();
        item = await LoadFullHistoryAsync(item);
        await PersistCurrentRequestDraftAsync();
        ResultContextVersion++;
        ClearResult();
        Signatures = [];
        ParameterStructures = [];
        SignatureReadFailed = false;
        TypeStructureVisible = false;
        SignatureInfoVisible = false;
        Input.Route = item.Route;
        Input.RegistryRootPath = item.RegistryRootPath;
        Input.ServiceName = item.ServiceName;
        Input.MethodName = item.MethodName;
        Input.Host = item.Host;
        Input.Port = item.Port;
        Input.RequestJson = item.RequestJson;
        Input.JavaParameterTypes = item.JavaParameterTypes;
        Input.Version = item.Version;
        Input.Group = item.Group;
        Input.AttachmentsJson = item.AttachmentsJson;
        PendingHistorySignaturePreference = new SignatureSelectionPreference(
            item.ServiceName,
            item.MethodName,
            JsonArgumentParser.ParseJavaTypes(item.JavaParameterTypes),
            item.Version,
            item.Group);
        await PersistCurrentRequestDraftAsync();
        if (!string.IsNullOrWhiteSpace(item.Response))
        {
            ResultText = item.Response;
            LastOutput = new InvocationOutput
            {
                Success = item.Success,
                Content = item.Response,
                Error = item.Success ? null : item.Response,
                RequestElapsed = item.ElapsedMs
            };
        }
        SetNotice($"已加载历史请求 {item.Endpoint}");
    }

    private void PresentResult(
        DateTimeOffset submittedAt,
        InvocationInput submittedInput,
        InvocationOutput output,
        string responseText)
    {
        LastOutput = output;
        if (!KeepResultHistory)
        {
            RetainedResultHistory.Clear();
            ResultText = responseText;
            return;
        }

        RetainedResultHistory.Prepend(FormatRetainedResult(
            submittedAt,
            submittedInput,
            output,
            responseText));
        ResultText = RetainedResultHistory.Text;
    }

    private static string FormatRetainedResult(
        DateTimeOffset submittedAt,
        InvocationInput input,
        InvocationOutput output,
        string responseText)
    {
        StringBuilder builder = new();
        builder.Append("请求时间：").AppendLine(submittedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss.fff zzz"));
        builder.Append("请求方法：").Append(input.ServiceName).Append('#').AppendLine(input.MethodName);
        if (!string.IsNullOrWhiteSpace(input.RegistryRootPath))
        {
            builder.Append("注册目录：").AppendLine(input.RegistryRootPath);
        }
        if (!string.IsNullOrWhiteSpace(input.JavaParameterTypes))
        {
            builder.Append("Java 参数类型：").AppendLine(input.JavaParameterTypes);
        }
        builder.AppendLine("请求参数：").AppendLine(input.RequestJson);
        builder.Append("响应状态：").Append(output.Success ? "成功" : "失败")
            .Append(" · ").Append(output.RequestElapsed).Append(" ms");
        if (output.RequestId is not null)
        {
            builder.Append(" · Request ID ").Append(output.RequestId);
        }
        builder.AppendLine().AppendLine("响应结果：").Append(responseText);
        return builder.ToString();
    }

