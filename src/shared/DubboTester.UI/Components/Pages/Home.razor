    private int HistoryNumber(InvocationHistory item)
    {
        int index = History.FindIndex(candidate => candidate.Id == item.Id);
        return index < 0
            ? 0
            : Math.Max(1, HistoryTotalCount - ((HistoryPageNumber - 1) * HistoryPageSize + index));
    }
