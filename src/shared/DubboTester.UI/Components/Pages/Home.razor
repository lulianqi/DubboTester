    private async Task SelectMethodAsync(DubboServiceItem service, string method)
    {
        await PersistCurrentRequestDraftAsync();
        ResultContextVersion++;
        if (!KeepResultHistory) ClearResult();
        SelectedService = service;
        Input.RegistryRootPath = service.RegistryRootPath;
        Input.ServiceName = service.Name;
        Input.MethodName = method;
        Input.JavaParameterTypes = string.Empty;
        Input.RequestJson = string.Empty;
        Input.Version = string.Empty;
        Input.Group = string.Empty;
        SelectedProvider = null;
        Signatures = [];
        ParameterStructures = [];
        SignatureReadFailed = false;
        TypeStructureVisible = false;
        SignatureInfoVisible = false;
        SelectedSignatureIndex = 0;
        PendingHistorySignaturePreference = null;
        await LoadSignaturesAsync(false);
    }

    private void OnMethodInputChanged()
    {
        PendingHistorySignaturePreference = null;
        ResultContextVersion++;
        if (!KeepResultHistory) ClearResult();
    }

    private async Task LoadSignaturesAsync(bool showInformationOnSuccess)
    {
        if (IsSignatureBusy || string.IsNullOrWhiteSpace(Input.ServiceName) || string.IsNullOrWhiteSpace(Input.MethodName)) return;
        if (showInformationOnSuccess) SignatureInfoVisible = false;
        SignatureSelectionPreference? preferredSignature = CaptureSignaturePreference();
        await PersistCurrentRequestDraftAsync();
        IsSignatureBusy = true;
        SignatureReadFailed = false;
        try
        {
            Signatures = (await Session.LoadMethodSignaturesAsync(
                Settings,
                Input.ServiceName.Trim(),
                Input.MethodName.Trim(),
                Input.RegistryRootPath)).ToList();
            if (Signatures.Count > 0)
            {
                SelectedSignatureIndex = preferredSignature is null
                    ? 0
                    : MethodSignatureSelectionResolver.FindBestMatchIndex(
                        Signatures,
                        preferredSignature.ParameterTypes,
                        preferredSignature.Version,
                        preferredSignature.Group);
                MethodSignatureItem selectedSignature = Signatures[SelectedSignatureIndex];
                await ApplySignatureAsync(selectedSignature);
                PendingHistorySignaturePreference = null;
                SetNotice($"已取得 {Signatures.Count} 个方法签名（来源：{selectedSignature.Source}）");
                if (showInformationOnSuccess) SignatureInfoVisible = true;
            }
            else
            {
                MarkSignatureReadFailed();
                SetWarning("未发现该方法的签名。请在下方手动填写精确 Java 参数类型后继续发送；多个类型用英文逗号分隔。");
            }
        }
        catch (Exception exception)
        {
            Signatures = [];
            ParameterStructures = [];
            TypeStructureVisible = false;
            SignatureInfoVisible = false;
            MarkSignatureReadFailed();
            SetWarning(
                $"未能自动读取方法签名。请在下方手动填写精确 Java 参数类型后继续发送；"
                + $"多个类型用英文逗号分隔。详情：{GetErrorMessage(exception)}");
        }
        finally { IsSignatureBusy = false; }
    }

    private SignatureSelectionPreference? CaptureSignaturePreference()
    {
        MethodSignatureItem? selected = SelectedSignature;
        if (selected is not null
            && string.Equals(selected.ServiceName, Input.ServiceName.Trim(), StringComparison.Ordinal)
            && string.Equals(selected.MethodName, Input.MethodName.Trim(), StringComparison.Ordinal))
        {
            return new SignatureSelectionPreference(
                selected.ServiceName,
                selected.MethodName,
                selected.ParameterTypes,
                selected.Version,
                selected.Group);
        }

        if (PendingHistorySignaturePreference is not null
            && string.Equals(PendingHistorySignaturePreference.ServiceName, Input.ServiceName.Trim(), StringComparison.Ordinal)
            && string.Equals(PendingHistorySignaturePreference.MethodName, Input.MethodName.Trim(), StringComparison.Ordinal))
        {
            return PendingHistorySignaturePreference;
        }

        return string.IsNullOrWhiteSpace(Input.JavaParameterTypes)
            ? null
            : new SignatureSelectionPreference(
                Input.ServiceName.Trim(),
                Input.MethodName.Trim(),
                JsonArgumentParser.ParseJavaTypes(Input.JavaParameterTypes),
                Input.Version,
                Input.Group);
    }

    private async Task SignatureChanged(ChangeEventArgs args)
    {
        if (!int.TryParse(args.Value?.ToString(), out int index) || index < 0 || index >= Signatures.Count) return;
        await PersistCurrentRequestDraftAsync();
        SelectedSignatureIndex = index;
        Input.RequestJson = string.Empty;
        await ApplySignatureAsync(Signatures[index]);
    }

    private async Task ApplySignatureAsync(MethodSignatureItem signature)
    {
        SignatureReadFailed = false;
        Input.JavaParameterTypes = string.Join(", ", signature.ParameterTypes);
        Input.Version = signature.Version ?? Input.Version;
        Input.Group = signature.Group ?? Input.Group;
        ParameterStructures = DubboTypeStructureBuilder.Build(signature);
        if (!HasParameterStructure) TypeStructureVisible = false;
        await RestoreCurrentRequestDraftAsync();
        await TryAutoFillRequestExampleAsync();
    }

    private void MarkSignatureReadFailed()
    {
        SignatureReadFailed = true;
        Input.Version = string.Empty;
        Input.Group = string.Empty;
    }

    private void OpenTypeStructure()
    {
        if (HasParameterStructure) TypeStructureVisible = true;
    }

    private void CloseTypeStructure() => TypeStructureVisible = false;

    private void CloseSignatureInfo() => SignatureInfoVisible = false;

