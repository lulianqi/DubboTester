    private async Task SaveSettingsAsync()
    {
        if (!ClientStorageReady)
        {
            SetWarning("本地设置尚未加载完成，请稍后重试");
            return;
        }

        SettingsDraft.RegistryAddress = SettingsDraft.RegistryAddress.Trim();
        SettingsDraft.RegistryRootPath = SettingsDraft.RegistryRootPath.Trim();
        SettingsDraft.MetadataRootPath = SettingsDraft.MetadataRootPath.Trim();
        SettingsDraft.HistoryLimit = HistoryRetentionPolicy.NormalizeLimit(SettingsDraft.HistoryLimit);
        Settings = SettingsDraft.Clone();
        SettingsVisible = false;
        Task catalogLoad = RefreshCatalogAsync(false);
        await PersistSettingsAsync();
        if (IndexedDbAvailable)
        {
            try
            {
                await JS.InvokeVoidAsync(
                    "dubboTester.indexedDb.trimHistory",
                    Settings.HistoryLimit);
                HistoryPageNumber = Math.Min(HistoryPageNumber, HistoryPageCount);
                await LoadHistoryPageAsync();
            }
            catch (JSException exception)
            {
                await FallBackFromIndexedDbAsync(exception);
            }
        }
        await catalogLoad;
    }

