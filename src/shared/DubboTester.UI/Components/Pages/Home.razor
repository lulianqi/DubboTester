@page "/"
@page "/dubbo"
@page "/independent-pages/dubbo"
@using System.Text
@using System.Text.Json
@implements IDisposable
@inject DubboSession Session
@inject DubboCatalogCache CatalogCache
@inject DubboCatalogPreloadService CatalogPreloader
@inject PressureTestDraftStore PressureDraft
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject IClipboardService ClipboardService
@inject ClientEnvironment ClientEnvironment
@inject GlobalRuntimeSettings RuntimeSettings
@inject IConfiguration Configuration

<PageTitle>Dubbo Tester</PageTitle>
<NavigationLock OnBeforeInternalNavigation="_ => PersistHomeRequestDraftAsync()" />

<div class="tester-shell">
    <header class="topbar">
        <div class="brand-block">
            <div class="brand-mark">D</div>
            <div>
                <div class="brand">Dubbo Tester</div>
                <div class="brand-subtitle">
                    <span>Native Dubbo2</span>
                    <span aria-hidden="true">·</span>
                    <button type="button" class="about-link" @onclick="OpenAbout">关于</button>
                </div>
            </div>
        </div>
        <div class="topbar-actions">
            <a class="mcp-entry topbar-mcp-entry" href="/mcp-service" title="配置远程 MCP 服务">
                <svg class="mcp-entry-icon" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
                    <circle cx="4" cy="8" r="2"></circle>
                    <circle cx="12" cy="4" r="2"></circle>
                    <circle cx="12" cy="12" r="2"></circle>
                    <path d="M5.8 7.1 10.2 4.9M5.8 8.9l4.4 2.2"></path>
                </svg>
                <span>MCP 服务</span>
            </a>
            <details class="feature-menu" data-dismiss-on-outside>
                <summary title="更多功能" aria-label="更多功能"><svg viewBox="0 0 16 16" aria-hidden="true"><path d="m4 6 4 4 4-4" /></svg></summary>
                <nav aria-label="更多功能菜单">
                    <a href="/http-service">
                        <svg viewBox="0 0 18 18" aria-hidden="true" focusable="false">
                            <circle cx="9" cy="9" r="6.5"></circle>
                            <path d="M2.8 9h12.4M9 2.5c2 1.8 3 4 3 6.5s-1 4.7-3 6.5C7 13.7 6 11.5 6 9s1-4.7 3-6.5Z"></path>
                        </svg>
                        <span>HTTP 服务</span>
                    </a>
                    <a href="/pressure-test">
                        <svg viewBox="0 0 18 18" aria-hidden="true" focusable="false">
                            <path d="M3.1 14a6.5 6.5 0 1 1 11.8 0"></path>
                            <path d="m9 10.2 3.2-3.1M5.2 12.8h7.6"></path>
                            <circle cx="9" cy="10.2" r="1"></circle>
                        </svg>
                        <span>压力测试</span>
                    </a>
                </nav>
            </details>
            <button class="icon-button"
                    title="@(ClientStorageReady ? "设置" : "正在读取本地设置")"
                    disabled="@(!ClientStorageReady)"
                    @onclick="OpenSettings">⚙</button>
        </div>
        <div class="notice @(NoticeIsError ? "notice-error" : NoticeIsWarning ? "notice-warning" : null)">
            <span class="notice-dot"></span>
            <span class="notice-message" title="@CatalogNotice">@CatalogNotice</span>
            @if (IsCatalogActive)
            {
                <button class="text-button notice-cancel" @onclick="StopCatalogLoad">结束加载</button>
            }
            else if (ClientStorageLoadFailed)
            {
                <button class="text-button notice-cancel" @onclick="RetryClientStorageAsync">重试本地存储</button>
            }
        </div>
    </header>

    <main class="workspace @(HistoryCollapsed ? "history-collapsed" : null)">
        <aside class="catalog-panel panel" aria-busy="@IsCatalogBusy">
            <div class="catalog-panel-body" inert="@IsCatalogBusy">
            <div class="panel-heading">
                <div>
                    <h2>服务目录</h2>
                    <span>@Services.Count 个服务</span>
                </div>
                <div class="catalog-heading-actions">
                    <button class="subtle-button" title="忽略缓存并刷新" disabled="@IsCatalogActive" @onclick="() => RefreshCatalogAsync(true)">刷新</button>
                    <details class="catalog-refresh-settings" data-dismiss-on-outside>
                        <summary class="catalog-refresh-settings-button"
                                 title="刷新设置"
                                 aria-label="刷新设置">⚙</summary>
                        <div class="catalog-refresh-settings-popover">
                            <label><input type="checkbox" @bind="Settings.OnlyRefreshServiceNames" @bind:after="PersistCatalogRefreshModeAsync" />仅刷新服务名称</label>
                            <small>关闭时同时刷新 Provider 与方法信息</small>
                        </div>
                    </details>
                </div>
            </div>

            <div class="search-box">
                <span>⌕</span>
                <input placeholder="搜索服务或方法…" @bind="SearchText" @bind:event="oninput" />
                @if (!string.IsNullOrWhiteSpace(SearchText))
                {
                    <button title="清除" @onclick="() => SearchText = string.Empty">×</button>
                }
            </div>

            @if (Services.Count == 0)
            {
                <div class="empty-state">
                    <div class="empty-icon">⌘</div>
                    <strong>尚未加载服务</strong>
                    <span>配置 @Settings.RegistryDisplayName 后刷新注册中心</span>
                    <button class="primary small" @onclick="OpenSettings">打开设置</button>
                </div>
            }
            else
            {
                <div class="service-tree">
                    <div class="tree-root"><span>▾</span><b>/</b></div>
                    @foreach (IGrouping<string, DubboServiceItem> registryGroup in FilteredServiceGroups)
                    {
                        <button type="button"
                                class="tree-root tree-indent registry-root-row"
                                title="@registryGroup.Key"
                                aria-expanded="@(IsRegistryRootExpanded(registryGroup.Key) ? "true" : "false")"
                                @onclick="() => ToggleRegistryRoot(registryGroup.Key)">
                            <span>@(IsRegistryRootExpanded(registryGroup.Key) ? "▾" : "›")</span><b>@RegistryRootPaths.DisplayName(registryGroup.Key)</b>
                        </button>
                        @if (IsRegistryRootExpanded(registryGroup.Key))
                        {
                            @foreach (DubboServiceItem service in registryGroup)
                            {
                                <div class="service-node @(ReferenceEquals(SelectedService, service) ? "active-service" : null)"
                                    @key="service">
                                    <button class="service-row" @onclick="() => ToggleServiceAsync(service)">
                                        <span class="chevron">@(IsServiceExpanded(service) ? "▾" : "›")</span>
                                        <span class="service-icon">⬡</span>
                                        <span class="service-name" title="@service.Name">@service.Name</span>
                                        @if (service.IsLoaded)
                                        {
                                            <span class="count-pill">@service.Methods.Count</span>
                                        }
                                    </button>

                                    @if (IsServiceExpanded(service))
                                    {
                                        <div class="service-children">
                                            @if (IsServiceLoading(service))
                                            {
                                                <div class="loading-row"><span class="spinner"></span>加载 Provider…</div>
                                            }
                                            else if (service.IsLoaded)
                                            {
                                                @foreach (DubboProviderItem provider in service.Providers)
                                                {
                                                    <button class="tree-item provider-item @(SelectedProvider?.RegistryUrl == provider.RegistryUrl ? "selected" : null)"
                                                            title="@provider.RegistryUrl"
                                                            @onclick="() => SelectProvider(service, provider)">
                                                        <span class="status-led @(provider.Disabled ? "disabled" : null)"></span>
                                                        <span>@provider.Address</span>
                                                        <small>@provider.Scheme</small>
                                                    </button>
                                                }
                                                @foreach (string method in FilterMethods(service.Methods))
                                                {
                                                    <button class="tree-item method-item @(Input.RegistryRootPath == service.RegistryRootPath && Input.ServiceName == service.Name && Input.MethodName == method ? "selected" : null)"
                                                            @onclick="() => SelectMethodAsync(service, method)">
                                                        <span>↪</span><span title="@method">@method</span>
                                                    </button>
                                                }
                                                @if (service.Providers.Count == 0)
                                                {
                                                    <div class="muted-row">没有可用 Provider</div>
                                                }
                                            }
                                        </div>
                                    }
                                </div>
                            }
                        }
                    }
                    @if (!FilteredServices.Any())
                    {
                        <div class="muted-row centered">没有匹配项</div>
                    }
                </div>
            }
            </div>
            @if (IsCatalogBusy)
            {
                <div class="catalog-loading-overlay" role="status">
                    <span class="spinner" aria-hidden="true"></span>
                    <strong>正在加载服务目录</strong>
                    <span>正在连接 @CatalogLoadingRegistryName，已等待 @CatalogLoadElapsedSeconds 秒</span>
                    <small>可在设置中修改地址，保存后立即重新加载</small>
                </div>
            }
        </aside>

        <div class="catalog-resizer"
             role="separator"
             aria-orientation="vertical"
             aria-label="调整服务目录宽度"
             title="拖动调整服务目录宽度"></div>

        <section class="request-panel panel">
            <div class="connection-bar">
                <label class="route-switch">
                    <select @bind="Input.Route" @bind:after="OnRouteChanged" disabled="@IsProviderTesting">
                        <option value="@InvocationRoute.Registry">注册中心</option>
                        <option value="@InvocationRoute.DirectProvider">直连 Provider</option>
                    </select>
                </label>
                <div class="address-field @(!IsDirectProviderRoute ? "disabled" : null)">
                    <span>主机地址</span>
                    <input placeholder="@(IsDirectProviderRoute ? "选择 Provider" : "根据注册中心自动选择")"
                           disabled="@(!IsDirectProviderRoute || IsProviderTesting)"
                           @bind="Input.Host" @bind:event="oninput" />
                </div>
                <input class="port-field" type="number" min="1" max="65535"
                       disabled="@(!IsDirectProviderRoute || IsProviderTesting)"
                       @bind="Input.Port" @bind:event="oninput" />
                <button class="connect-button @ProviderTestClass"
                        title="连接主机"
                        aria-label="连接主机"
                        disabled="@(!IsDirectProviderRoute || IsProviderTesting)"
                        @onclick="TestProviderAsync">
                    @if (IsProviderTesting)
                    {
                        <span class="spinner"></span>
                    }
                    else
                    {
                        <svg class="connect-icon" viewBox="0 0 20 20" aria-hidden="true" focusable="false">
                            <path d="M7 2.5v4M13 2.5v4M5 6.5h10v2a5 5 0 0 1-5 5v4M7.5 17.5h5" />
                        </svg>
                    }
                </button>
            </div>

            <div class="endpoint-row">
                <div class="endpoint-input service-endpoint">
                    <span>服务</span>
                    <input placeholder="com.foo.DemoService" @bind="Input.ServiceName" @bind:event="oninput" />
                </div>
                <div class="endpoint-separator">#</div>
                <div class="endpoint-input method-endpoint">
                    <span>方法</span>
                    <input placeholder="methodName" @bind="Input.MethodName" @bind:event="oninput" @bind:after="OnMethodInputChanged" />
                </div>
                <button class="subtle-button signature-load" disabled="@(IsSignatureBusy || string.IsNullOrWhiteSpace(Input.MethodName))" @onclick="() => LoadSignaturesAsync(true)">
                    @(IsSignatureBusy ? "加载中…" : "读取签名")
                </button>
            </div>

            <div class="signature-area">
                <div class="signature-strip @(SignatureReadFailed ? "signature-warning" : null)">
                    <span class="strip-label">Java 签名</span>
                    @if (Signatures.Count > 0)
                    {
                        <span class="signature-display"
                              title="@Signatures[SelectedSignatureIndex].Signature">
                            @Signatures[SelectedSignatureIndex].Signature
                        </span>
                        @if (Signatures.Count > 1)
                        {
                            <select class="overload-picker"
                                    aria-label="选择重载签名"
                                    title="选择重载签名"
                                    disabled="@IsSignatureBusy"
                                    value="@SelectedSignatureIndex"
                                    @onchange="SignatureChanged">
                                @for (int index = 0; index < Signatures.Count; index++)
                                {
                                    <option value="@index">重载 @(index + 1)</option>
                                }
                            </select>
                        }
                        <span class="source-badge">@Signatures[SelectedSignatureIndex].Source</span>
                    }
                    else if (SignatureReadFailed)
                    {
                        <span class="signature-fallback">未能自动读取签名，请在下方手动填写参数类型</span>
                    }
                    else
                    {
                        <input placeholder="自动解析；也可填写 java.lang.String, java.lang.Long"
                               @bind="Input.JavaParameterTypes"
                               @bind:event="oninput" />
                    }
                </div>
                @if (SignatureReadFailed)
                {
                    <label class="manual-types-field">
                        <span>Java 参数类型</span>
                        <input @bind="Input.JavaParameterTypes"
                               @bind:event="oninput"
                               placeholder="例如：int, java.lang.String；数组：double[]；集合：java.util.List" />
                        <small>按方法参数顺序填写精确类型，多个用英文逗号分隔；对象使用完整类名，集合填写原始类型且不要带泛型。</small>
                    </label>
                }
            </div>

            <section class="editor-card request-editor">
                <div class="editor-toolbar">
                    <div>
                        <b>请求参数</b>
                        <span>JSON 参数数组；单个对象可直接填写</span>
                    </div>
                    <div class="toolbar-actions">
                        @if (HasParameterStructure)
                        {
                            <button class="text-button" @onclick="OpenTypeStructure">参数结构</button>
                        }
                        @if (CanGenerateRequestExample)
                        {
                            <button class="text-button" title="根据 Java 参数类型和元数据结构生成示例并替换当前请求内容" @onclick="GenerateRequestExample">按结构生成示例</button>
                        }
                        <details class="request-example-settings" data-dismiss-on-outside>
                            <summary aria-label="示例自动填充设置" title="示例自动填充设置">⋮</summary>
                            <div class="request-example-settings-popover">
                                <label>
                                    <input type="checkbox" disabled="@(!ClientStorageReady)" @bind="Settings.AutoFillRequestExample" @bind:after="AutoFillRequestExampleChangedAsync" />
                                    如果用户数据为空，自动填充示例
                                </label>
                                <small>保留已有输入和历史草稿；仅在元数据可用且方法有参数时填充。</small>
                            </div>
                        </details>
                        <button class="text-button" @onclick="FormatRequest">格式化</button>
                    </div>
                </div>
                <textarea spellcheck="false"
                          value="@Input.RequestJson"
                          placeholder="@RequestJsonPlaceholder"
                          @oninput="RequestJsonChanged"
                          @onchange="PersistCurrentRequestDraftAsync"></textarea>
            </section>

            <div class="action-row">
                <details class="advanced-options" data-dismiss-on-outside>
                    <summary>高级选项</summary>
                    <div class="advanced-popover">
                        <label>服务版本<input @bind="Input.Version" @bind:event="oninput" placeholder="可选" /></label>
                        <label>服务分组<input @bind="Input.Group" @bind:event="oninput" placeholder="可选" /></label>
                        <label class="wide">
                            <span>Attachments JSON <small>可选，随 RPC 请求传递，类似请求 Header</small></span>
                            <textarea @bind="Input.AttachmentsJson" @bind:event="oninput" placeholder='{"traceId":"..."}'></textarea>
                        </label>
                        @if (Signatures.Count > 0)
                        {
                            <label class="wide">Java 参数类型<input @bind="Input.JavaParameterTypes" @bind:event="oninput" /></label>
                        }
                    </div>
                </details>
                <div class="send-hint">
                    @if (Input.Route == InvocationRoute.Registry)
                    {
                        <span>由注册中心发现并负载均衡</span>
                    }
                    else
                    {
                        <span>直连模式需要精确 Java 类型</span>
                    }
                </div>
                <div class="split-send">
                    <button class="primary send-button split-send-main" disabled="@(IsInvoking || IsProviderTesting)" @onclick="InvokeAsync">
                        @if (IsInvoking)
                        {
                            <span class="spinner light send-button-icon"></span><span class="send-button-label">发送中</span>
                        }
                        else
                        {
                            <span class="send-button-icon">▷</span><span class="send-button-label">发送</span>
                        }
                    </button>
                    <details class="send-more" data-dismiss-on-outside>
                        <summary title="更多发送方式" aria-label="更多发送方式">▾</summary>
                        <div class="send-more-menu">
                            <button @onclick="OpenPressureTest">
                                <span class="menu-icon">◫</span>
                                <span><b>压力测试</b><small>并发发送并查看性能指标</small></span>
                            </button>
                        </div>
                    </details>
                </div>
            </div>

            <section class="editor-card result-editor">
                <div class="editor-toolbar result-toolbar">
                    <div class="result-title">
                        <b>响应结果</b>
                        @if (LastOutput is not null)
                        {
                            <span class="result-state @(LastOutput.Success ? "success" : "failed")">
                                @(LastOutput.Success ? "成功" : "失败")
                            </span>
                            <span>@LastOutput.RequestElapsed ms</span>
                            @if (LastOutput.RequestId is not null)
                            {
                                <span>Request ID @LastOutput.RequestId</span>
                            }
                        }
                    </div>
                    <div class="toolbar-actions">
                        <label class="result-history-toggle"
                               title="最新响应会追加到最前面；最多保留约 20 万字符，超出后自动丢弃较早内容">
                            <input type="checkbox" @bind="KeepResultHistory" />
                            <span>保留历史记录</span>
                        </label>
                        <button class="text-button" disabled="@string.IsNullOrEmpty(ResultText)" @onclick="CopyResultAsync">复制</button>
                        <button class="text-button" disabled="@string.IsNullOrEmpty(ResultText)" @onclick="DownloadResultAsync">下载</button>
                        <button class="text-button" disabled="@string.IsNullOrEmpty(ResultText)" @onclick="ClearResult">清空</button>
                    </div>
                </div>
                <pre class="result-content @(LastOutput is { Success: false } && !KeepResultHistory ? "error-content" : null)">@ResultText</pre>
            </section>
        </section>

        <aside class="history-panel panel @(HistoryCollapsed ? "collapsed" : null) @(DetailedHistory is not null ? "detail-open" : null)"
               @onclick="CloseHistoryDetails">
            <div class="panel-heading history-heading">
                @if (HistoryCollapsed)
                {
                    <button class="history-collapse-button expand"
                            title="展开历史记录"
                            aria-label="展开历史记录"
                            @onclick="ToggleHistoryCollapsedAsync">‹</button>
                }
                else
                {
                    <div>
                        <h2>历史记录</h2>
                        <span>@HistoryTotalCount 条</span>
                    </div>
                    <div class="history-actions">
                        <button class="heart-filter @(FavoritesOnly ? "active" : null)" title="只看收藏" @onclick="ToggleFavoritesOnly">♥</button>
                        <button class="subtle-button danger" disabled="@(History.Count == 0)" @onclick="ClearHistoryAsync">清空</button>
                        <button class="history-collapse-button"
                                title="折叠历史记录"
                                aria-label="折叠历史记录"
                                @onclick="ToggleHistoryCollapsedAsync">›</button>
                    </div>
                }
            </div>
            @if (!HistoryCollapsed)
            {
                <div class="history-filter-bar">
                    <label class="save-response-setting">
                        <input type="checkbox" @bind="Settings.SaveResponseInHistory" @bind:after="PersistSettingsAsync" />
                        <span>历史中保存响应正文</span>
                    </label>
                    <label class="history-search-box">
                        <span aria-hidden="true">⌕</span>
                        <input value="@HistorySearchText"
                               @oninput="HistorySearchChanged"
                               placeholder="搜索历史记录…"
                               aria-label="搜索历史记录" />
                        @if (!string.IsNullOrWhiteSpace(HistorySearchText))
                        {
                            <button type="button" title="清空历史搜索" aria-label="清空历史搜索" @onclick="ClearHistorySearch">×</button>
                        }
                    </label>
                </div>
                <div class="history-list" @onscroll="CloseHistoryDetails">
                    @foreach (InvocationHistory item in History)
                    {
                        <article id="@HistoryElementId(item)"
                                 class="history-card @(item.Success ? null : "failed") @(DetailedHistory?.Id == item.Id ? "selected" : null)"
                                 title="点击查看详情"
                                 @onclick="() => ShowHistoryDetailsAsync(item)"
                                 @onclick:stopPropagation="true"
                                 @key="item.Id">
                            <div class="history-main">
                                <div class="history-meta">
                                    <span class="history-id">#@HistoryNumber(item)</span>
                                    <span>@item.CreatedAt.ToLocalTime().ToString("MM-dd HH:mm:ss")</span>
                                    <span>@item.ElapsedMs ms</span>
                                    <button type="button"
                                            class="history-load-link"
                                            title="载入到发送区域"
                                            @onclick="() => LoadHistoryAsync(item)"
                                            @onclick:stopPropagation="true">载入</button>
                                </div>
                                <strong title="@item.Endpoint">@item.Endpoint</strong>
                                <code title="@item.RequestJson">@OneLine(item.RequestJson)</code>
                            </div>
                            <div class="history-card-actions">
                                <button type="button"
                                        class="favorite @(item.Favorite ? "active" : null)"
                                        title="收藏"
                                        @onclick="() => ToggleFavoriteAsync(item)"
                                        @onclick:stopPropagation="true">♥</button>
                                <button type="button"
                                        title="删除"
                                        @onclick="() => DeleteHistoryAsync(item)"
                                        @onclick:stopPropagation="true">×</button>
                            </div>
                        </article>
                    }
                    @if (History.Count == 0)
                    {
                        <div class="empty-state compact">
                            <span>@(string.IsNullOrWhiteSpace(HistorySearchText) ? "暂无历史记录" : "没有匹配的历史记录")</span>
                        </div>
                    }
                </div>
                @if (HistoryPageCount > 1)
                {
                    <nav class="history-pagination" aria-label="调用历史分页">
                        <button type="button" disabled="@(HistoryPageNumber <= 1)" @onclick="() => ChangeHistoryPageAsync(HistoryPageNumber - 1)">上一页</button>
                        <span>第 @HistoryPageNumber / @HistoryPageCount 页</span>
                        <button type="button" disabled="@(HistoryPageNumber >= HistoryPageCount)" @onclick="() => ChangeHistoryPageAsync(HistoryPageNumber + 1)">下一页</button>
                    </nav>
                }
            }
        </aside>
    </main>

    @if (DetailedHistory is not null && HistoryDetailPlacement is not null)
    {
        <button type="button"
                class="history-detail-dismiss"
                aria-label="关闭历史详情"
                @onclick="CloseHistoryDetails"></button>
        <section class="history-detail-popover arrow-@HistoryDetailPlacement.ArrowSide"
                 style="@HistoryDetailStyle"
                 role="dialog"
                 aria-label="历史记录详情"
                 @onclick:stopPropagation="true">
            <header>
                <div>
                    <div class="history-detail-heading">
                        <strong>历史详情 #@HistoryNumber(DetailedHistory)</strong>
                        <span class="result-state @(DetailedHistory.Success ? "success" : "failed")">
                            @(DetailedHistory.Success ? "成功" : "失败")
                        </span>
                    </div>
                    <small>@DetailedHistory.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss") · @DetailedHistory.ElapsedMs ms</small>
                </div>
                <button type="button" title="关闭" aria-label="关闭历史详情" @onclick="CloseHistoryDetails">×</button>
            </header>
            <div class="history-detail-content">
                <div class="history-detail-endpoint" title="@DetailedHistory.Endpoint">@DetailedHistory.Endpoint</div>
                <dl>
                    <dt>调用方式</dt>
                    <dd>@HistoryRouteText(DetailedHistory)</dd>
                    <dt>目标地址</dt>
                    <dd>@HistoryTargetText(DetailedHistory)</dd>
                    @if (!string.IsNullOrWhiteSpace(DetailedHistory.Version))
                    {
                        <dt>服务版本</dt>
                        <dd>@DetailedHistory.Version</dd>
                    }
                    @if (!string.IsNullOrWhiteSpace(DetailedHistory.Group))
                    {
