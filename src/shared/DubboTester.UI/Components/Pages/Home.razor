@code {
    private const string DubboNetVersion = "3.6.2";
    private bool RuntimeSettingsVisible;
    private string? RuntimeSettingsError;
    private int SettingsTitleClickCount;
    private DateTimeOffset LastSettingsTitleClick;
    private const string RequestJsonPlaceholder =
        "请输入 JSON 参数数组，例如：[\"text\", 123]\n"
        + "Class 对象直接按字段填写，例如：{\"name\": \"张三\", \"age\": 18}\n"
        + "多个参数时将对象放入数组，例如：[{\"name\": \"张三\"}, 123]\n"
        + "也可以点击上方“按结构生成示例”自动生成示例参数";
    private string DubboTesterVersion => Configuration["DubboTester:Version"] ?? "未知";
    private const string SettingsStorageKey = "dubbo-tester.settings.v1";
    private const string LegacyHistoryStorageKey = "dubbo-tester.history.v1";
    private const string LegacyRequestDraftStorageKey = "dubbo-tester.request-drafts.v1";
    private const string HistoryCollapsedStorageKey = "dubbo-tester.history-collapsed.v1";
    private const string CatalogWidthStorageKey = "dubbo-tester.catalog-width.v1";
    private const int HistoryPageSize = 100;
    private static readonly JsonSerializerOptions StorageJsonOptions = new(JsonSerializerDefaults.Web);
    private static readonly JsonSerializerOptions MetadataJsonOptions = new(JsonSerializerDefaults.Web)
    {
        WriteIndented = true,
        Encoder = System.Text.Encodings.Web.JavaScriptEncoder.UnsafeRelaxedJsonEscaping
    };

    private TesterSettings Settings { get; set; } = new();
    private TesterSettings SettingsDraft { get; set; } = new();
    private InvocationInput Input { get; set; } = new();
    private readonly SemaphoreSlim HomeDraftSaveGate = new(1, 1);
    private string? LastSavedHomeDraftJson;
    private bool HomeDraftSaveFailed;
    private List<DubboServiceItem> Services { get; set; } = [];
    private List<MethodSignatureItem> Signatures { get; set; } = [];
    private IReadOnlyList<MethodParameterStructure> ParameterStructures { get; set; } = [];
    private List<InvocationHistory> History { get; set; } = [];
    private Dictionary<string, string> RequestDrafts { get; set; } = new(StringComparer.Ordinal);
    private DubboServiceItem? SelectedService { get; set; }
    private HashSet<string> CollapsedRegistryRootKeys { get; } = new(StringComparer.Ordinal);
    private HashSet<string> ExpandedServiceKeys { get; } = new(StringComparer.Ordinal);
    private HashSet<string> LoadingServiceKeys { get; } = new(StringComparer.Ordinal);
    private DubboProviderItem? SelectedProvider { get; set; }
    private InvocationOutput? LastOutput { get; set; }
    private ResponseResultHistoryBuffer RetainedResultHistory { get; } = new();
    private string SearchText { get; set; } = string.Empty;
    private string HistorySearchText { get; set; } = string.Empty;
    private int HistoryPageNumber { get; set; } = 1;
    private int HistoryTotalCount { get; set; }
    private int HistoryLoadVersion { get; set; }
    private string ResultText { get; set; } = string.Empty;
    private bool KeepResultHistory { get; set; }
    private long ResultContextVersion { get; set; }
    private string Notice { get; set; } = "请先配置注册中心，然后刷新服务目录";
    private bool NoticeIsError { get; set; }
    private bool NoticeIsWarning { get; set; }
    private bool AboutVisible { get; set; }
    private bool SettingsVisible { get; set; }
    private bool TypeStructureVisible { get; set; }
    private bool SignatureInfoVisible { get; set; }
    private bool FavoritesOnly { get; set; }
    private bool HistoryCollapsed { get; set; }
    private InvocationHistory? DetailedHistory { get; set; }
    private AnchoredPopoverPlacement? HistoryDetailPlacement { get; set; }
    private bool IsCatalogBusy { get; set; }
    private CancellationTokenSource? CatalogLoadCancellation { get; set; }
    private TesterSettings? DisplayedCatalogSettings { get; set; }
    private DateTimeOffset CatalogLoadStartedAt { get; set; }
    private string CatalogLoadingRegistryName { get; set; } = string.Empty;
    private string CatalogLoadingMessage { get; set; } = string.Empty;
    private int CatalogLoadElapsedSeconds => Math.Max(0, (int)(DateTimeOffset.UtcNow - CatalogLoadStartedAt).TotalSeconds);
    private CancellationTokenSource? CatalogPreloadTrackingCancellation { get; set; }
    private CatalogPreloadStatus? PreloadStatus { get; set; }
    private bool CatalogStopRequested { get; set; }
    private bool IsDisposed { get; set; }
    private bool IsSignatureBusy { get; set; }
    private bool SignatureReadFailed { get; set; }
    private bool IsProviderTesting { get; set; }
    private bool IsInvoking { get; set; }
    private bool ClientStorageReady { get; set; }
    private bool ClientStorageLoading { get; set; }
    private bool ClientStorageLoadFailed { get; set; }
    private bool IndexedDbAvailable { get; set; } = true;
    private int ClientStorageLoadAttempts { get; set; }
    private bool? ProviderTestSucceeded { get; set; }
    private bool IsDirectProviderRoute => Input.Route == InvocationRoute.DirectProvider;
    private int SelectedSignatureIndex { get; set; }
    private SignatureSelectionPreference? PendingHistorySignaturePreference { get; set; }
    private MethodSignatureItem? SelectedSignature =>
        SelectedSignatureIndex >= 0 && SelectedSignatureIndex < Signatures.Count
            ? Signatures[SelectedSignatureIndex]
            : null;
    private bool HasParameterStructure =>
        DubboTypeStructureBuilder.HasDetailedStructure(ParameterStructures);
    private bool CanGenerateRequestExample => SelectedSignature is not null;
    private bool IsCatalogPreloading =>
        PreloadStatus?.State == CatalogPreloadState.Running;
    private bool IsCatalogActive => IsCatalogBusy || IsCatalogPreloading;
    private string CatalogNotice => IsCatalogBusy
        ? $"{CatalogLoadingMessage}（已等待 {CatalogLoadElapsedSeconds} 秒）"
        : IsCatalogPreloading
        ? CatalogStopRequested
            ? "正在结束后台方法预取，已完成的数据会保留…"
            : $"正在后台预取服务方法：{PreloadStatus!.LoadedServiceCount}/{PreloadStatus.TotalServiceCount}，"
              + $"失败 {PreloadStatus.FailedServiceCount}，剩余 {PreloadStatus.PendingServiceCount}"
        : Notice;

    private IEnumerable<DubboServiceItem> FilteredServices
    {
        get
        {
            if (string.IsNullOrWhiteSpace(SearchText))
            {
                return Services;
            }

            StringComparison comparison = Settings.CaseSensitiveSearch
                ? StringComparison.Ordinal
                : StringComparison.OrdinalIgnoreCase;
            return Services.Where(service =>
                (!Settings.SearchMethodsOnly && service.Name.Contains(SearchText, comparison))
                || service.Methods.Any(method => method.Contains(SearchText, comparison)));
        }
    }

    private IEnumerable<IGrouping<string, DubboServiceItem>> FilteredServiceGroups =>
        FilteredServices
            .GroupBy(service => service.RegistryRootPath, StringComparer.Ordinal)
            .OrderBy(group => group.Key, StringComparer.Ordinal);

    private int HistoryPageCount => Math.Max(1,
        (int)Math.Ceiling(HistoryTotalCount / (double)HistoryPageSize));

    private string HistoryDetailStyle => HistoryDetailPlacement is null
        ? string.Empty
        : FormattableString.Invariant(
            $"left:{HistoryDetailPlacement.Left}px;top:{HistoryDetailPlacement.Top}px;width:{HistoryDetailPlacement.Width}px;height:{HistoryDetailPlacement.Height}px;--history-detail-arrow-top:{HistoryDetailPlacement.ArrowTop}px;");

    private string ProviderTestClass => !IsDirectProviderRoute ? string.Empty : ProviderTestSucceeded switch
    {
        true => "connected",
        false => "disconnected",
        _ => string.Empty
    };

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        try
        {
            // 缓存和设置加载会触发后续渲染。每次渲染都让脚本幂等检查一次，
            // 这样拖拽条节点被 Blazor 更新后也能重新绑定事件。
            await JS.InvokeVoidAsync(
                "dubboTester.initializeCatalogResize",
                ".workspace",
                ".catalog-resizer",
                CatalogWidthStorageKey);
        }
        catch (JSDisconnectedException)
        {
            // The Blazor circuit can reconnect during debugging or deployment.
            // Client storage initialization below will retry on a later render.
        }

        if (ClientStorageReady)
        {
            await PersistHomeRequestDraftAsync();
            return;
        }

        if (ClientStorageLoading)
        {
            return;
        }

        await InitializeClientStorageAsync();
    }

    private async Task InitializeClientStorageAsync()
    {
        ClientStorageLoading = true;
        bool shouldRetry = false;
        try
        {
            string? settingsJson = await JS.InvokeAsync<string?>("dubboTester.load", SettingsStorageKey);
            string? historyCollapsed = await JS.InvokeAsync<string?>("dubboTester.load", HistoryCollapsedStorageKey);
            bool settingsWereInvalid = false;
            try
            {
                Settings = string.IsNullOrWhiteSpace(settingsJson)
                    ? new TesterSettings()
                    : JsonSerializer.Deserialize<TesterSettings>(settingsJson, StorageJsonOptions)
                        ?? new TesterSettings();
            }
            catch (JsonException)
            {
                Settings = new TesterSettings();
                settingsWereInvalid = true;
            }
            HistoryCollapsed = bool.TryParse(historyCollapsed, out bool collapsed) && collapsed;

            Settings.HistoryLimit = HistoryRetentionPolicy.NormalizeLimit(Settings.HistoryLimit);
            string? historyJson = null;
            Exception? indexedDbError = null;
            for (int attempt = 1; attempt <= 3; attempt++)
            {
                try
                {
                    await JS.InvokeVoidAsync(
                        "dubboTester.indexedDb.initialize",
                        LegacyHistoryStorageKey,
                        LegacyRequestDraftStorageKey);
                    await JS.InvokeVoidAsync(
                        "dubboTester.indexedDb.trimHistory",
                        Settings.HistoryLimit);
                    historyJson = await JS.InvokeAsync<string?>(
                        "dubboTester.indexedDb.loadHistoryPage",
                        HistoryPageNumber,
                        HistoryPageSize,
                        HistorySearchText,
                        FavoritesOnly);
                    IndexedDbAvailable = true;
                    indexedDbError = null;
                    break;
                }
                catch (JSException exception)
                {
                    indexedDbError = exception;
                    if (attempt < 3) await Task.Delay(attempt * 200);
                }
            }

            if (indexedDbError is not null)
            {
                IndexedDbAvailable = false;
                ClientStorageLoadFailed = true;
                historyJson = await JS.InvokeAsync<string?>(
                    "dubboTester.load",
                    LegacyHistoryStorageKey);
            }

            bool historyWasInvalid = false;
            try
            {
                if (IndexedDbAvailable)
                {
                    HistoryPagePayload page = string.IsNullOrWhiteSpace(historyJson)
                        ? new HistoryPagePayload()
                        : JsonSerializer.Deserialize<HistoryPagePayload>(historyJson, StorageJsonOptions)
                            ?? new HistoryPagePayload();
                    History = page.Items;
                    HistoryTotalCount = page.TotalCount;
                }
                else
                {
                    List<InvocationHistory> legacyHistory = string.IsNullOrWhiteSpace(historyJson)
                        ? []
                        : JsonSerializer.Deserialize<List<InvocationHistory>>(historyJson, StorageJsonOptions) ?? [];
                    HistoryRetentionPolicy.TrimToLimit(legacyHistory, Settings.HistoryLimit);
                    HistoryTotalCount = legacyHistory.Count;
                    History = legacyHistory.Take(HistoryPageSize).ToList();
                }
            }
            catch (JsonException)
            {
                History = [];
                HistoryTotalCount = 0;
                historyWasInvalid = true;
            }
            await RestoreHomeRequestDraftAsync();
            SettingsDraft = Settings.Clone();
            ClientStorageReady = true;
            ClientStorageLoadAttempts = 0;
            if (Settings.AutoFillRequestExample)
            {
                await RestoreCurrentRequestDraftAsync();
                await TryAutoFillRequestExampleAsync();
            }

            if (settingsWereInvalid)
            {
                SetWarning($"{ClientEnvironment.StorageLocation}的连接设置无法解析，当前已使用默认值；只有主动保存时才会覆盖原数据");
            }
            else if (historyWasInvalid)
            {
                SetWarning($"{ClientEnvironment.StorageLocation}的调用历史无法解析，原数据尚未被自动覆盖");
            }
            else if (indexedDbError is not null)
            {
                SetWarning($"本地数据库暂时不可用，调用历史和请求草稿仅在当前界面保留：{GetErrorMessage(indexedDbError)}");
            }

            StateHasChanged();

            if (!string.IsNullOrWhiteSpace(Settings.RegistryAddress))
            {
                await RefreshCatalogAsync(false);
            }
        }
        catch (Exception exception) when (
            exception is JSDisconnectedException or OperationCanceledException)
        {
            ClientStorageLoadFailed = true;
            SetWarning("界面连接已中断，本地设置和历史记录将在连接恢复后重新读取");
        }
        catch (Exception exception)
        {
            ClientStorageLoadAttempts++;
            ClientStorageLoadFailed = ClientStorageLoadAttempts >= 3;
            shouldRetry = !ClientStorageLoadFailed;
            SetNotice($"读取本地设置失败：{exception.Message}", true);
            StateHasChanged();
        }
        finally
        {
            ClientStorageLoading = false;
        }

        if (shouldRetry && !IsDisposed)
        {
            await Task.Delay(ClientStorageLoadAttempts * 250);
            await InitializeClientStorageAsync();
        }
    }

    private async Task RetryClientStorageAsync()
    {
        ClientStorageLoadAttempts = 0;
        ClientStorageLoadFailed = false;
        ClientStorageReady = false;
        IndexedDbAvailable = true;
        await InitializeClientStorageAsync();
    }

    private async Task RefreshCatalogAsync(bool forceRefresh = false)
    {
        CancelCatalogLoad();
        if (forceRefresh) CollapsedRegistryRootKeys.Clear();
        CancelCatalogPreloadTracking();
        PreloadStatus = null;
        TesterSettings settings = Settings.Clone();
        var cancellation = new CancellationTokenSource();
        CancellationToken token = cancellation.Token;
        CatalogLoadCancellation = cancellation;
        CatalogStopRequested = false;
        IsCatalogBusy = true;
        CatalogLoadStartedAt = DateTimeOffset.UtcNow;
        CatalogLoadingRegistryName = settings.RegistryDisplayName;
        CatalogLoadingMessage = forceRefresh
            ? $"正在连接 {settings.RegistryDisplayName} 并重新读取服务目录…"
            : $"正在连接 {settings.RegistryDisplayName} 并加载服务目录（优先使用全局缓存）…";
        SetNotice(CatalogLoadingMessage);
        if (DisplayedCatalogSettings is not null && !IsSameCatalog(DisplayedCatalogSettings, settings))
        {
            Services = [];
            SelectedService = null;
            SelectedProvider = null;
            CollapsedRegistryRootKeys.Clear();
            ExpandedServiceKeys.Clear();
            LoadingServiceKeys.Clear();
        }
        _ = TrackCatalogLoadElapsedAsync(cancellation, token);
        try
        {
            await InvokeAsync(StateHasChanged);
            // 注册中心构造函数可能同步等待连接。每次加载使用独立会话并在后台运行，
            // 确保改地址后不必等待旧连接释放，也不会阻塞 Blazor 的渲染与交互。
            DubboCatalogLoadResult result = await Task.Run(async () =>
            {
                using var catalogSession = new DubboSession(CatalogCache);
                return await catalogSession.LoadServicesAsync(settings, forceRefresh, token);
            }, token).WaitAsync(token);
            if (!IsCurrentCatalogLoad(cancellation)) return;
            Services = result.Services.ToList();
            DisplayedCatalogSettings = settings;
            SelectedService = null;
            ExpandedServiceKeys.Clear();
            LoadingServiceKeys.Clear();

            if (!settings.OnlyRefreshServiceNames
                && !result.HasAllServiceDetails
                && !result.PreloadAttempted)
            {
                PreloadStatus = CatalogPreloader.StartOrGet(settings, result.Services);
                StartCatalogPreloadTracking(settings);
            }

            string source = result.FromCache ? "全局缓存" : settings.RegistryDisplayName;
            if (IsCatalogPreloading)
            {
                SetNotice(
                    $"已从{source}加载 {Services.Count} 个服务，Provider 与方法正在后台预取");
            }
            else if (!settings.OnlyRefreshServiceNames && !result.HasAllServiceDetails)
            {
                SetNotice(
                    $"已从{source}加载 {Services.Count} 个服务；因 {settings.RegistryDisplayName} 超时或连接波动，"
                    + $"仍有 {result.PendingServiceDetailCount} 个服务未预取，可展开服务重试或强制刷新");
            }
            else
            {
                if (Services.Count == 0
                    && RegistryRootPaths.Parse(settings.RegistryRootPath).AutoDiscover)
                {
                    SetNotice(settings.RegistryType == RegistryCenterType.Nacos
                        ? "已扫描 Nacos 全部分组，但未发现可用的 Dubbo Provider"
                        : "已扫描 ZooKeeper 一级节点，但未发现包含可用 Provider 的 Dubbo 注册目录", true);
                    return;
                }
                string details = result.HasAllServiceDetails ? "，已包含全部服务方法" : string.Empty;
                string roots = result.RegistryRoots.Count > 1
                    ? $"，来自 {result.RegistryRoots.Count} 个注册目录"
                    : string.Empty;
                SetNotice($"已就绪：从{source}加载 {Services.Count} 个 Dubbo 服务{roots}{details}");
            }
        }
        catch (OperationCanceledException) when (token.IsCancellationRequested)
        {
            // 停止或被新请求取代时不再加载缓存，也不更新新请求的提示与目录。
        }
        catch (Exception exception)
        {
            if (IsCurrentCatalogLoad(cancellation))
                SetNotice($"加载注册中心失败：{GetErrorMessage(exception)}", true);
        }
        finally
        {
            bool isCurrent = IsCurrentCatalogLoad(cancellation);
            if (isCurrent)
            {
                IsCatalogBusy = false;
                CatalogLoadCancellation = null;
            }
            cancellation.Cancel();
            cancellation.Dispose();
            if (isCurrent)
            {
                await InvokeAsync(StateHasChanged);
            }
        }
    }

    private bool IsCurrentCatalogLoad(CancellationTokenSource cancellation) =>
        !IsDisposed && ReferenceEquals(CatalogLoadCancellation, cancellation);

    private void CancelCatalogLoad()
    {
        CancellationTokenSource? previous = CatalogLoadCancellation;
        CatalogLoadCancellation = null;
        IsCatalogBusy = false;
        previous?.Cancel();
    }

    private async Task TrackCatalogLoadElapsedAsync(
        CancellationTokenSource cancellation,
        CancellationToken token)
    {
        try
        {
            while (!token.IsCancellationRequested)
            {
                await Task.Delay(TimeSpan.FromSeconds(1), token);
                await InvokeAsync(() =>
                {
                    if (IsCurrentCatalogLoad(cancellation)) StateHasChanged();
                });
            }
        }
        catch (OperationCanceledException) when (token.IsCancellationRequested) { }
    }

    private void StopCatalogLoad()
    {
        CatalogStopRequested = true;
        if (IsCatalogBusy && CatalogLoadCancellation is not null)
        {
            CancelCatalogLoad();
            SetNotice(Services.Count == 0
                ? "已手动结束服务目录加载"
                : $"已手动结束加载，已保留当前 {Services.Count} 个服务及成功预取的方法");
            return;
        }

        if (IsCatalogPreloading)
        {
            CatalogPreloader.Stop(Settings);
            SetNotice("正在结束后台方法预取，已完成的数据会保留…");
        }
    }

    private void StartCatalogPreloadTracking(TesterSettings settings)
    {
        CancelCatalogPreloadTracking();
        var cancellation = new CancellationTokenSource();
        CatalogPreloadTrackingCancellation = cancellation;
        _ = TrackCatalogPreloadAsync(settings, cancellation);
    }

    private async Task TrackCatalogPreloadAsync(
        TesterSettings settings,
        CancellationTokenSource cancellation)
    {
        try
        {
            while (!cancellation.IsCancellationRequested)
            {
                CatalogPreloadStatus? status = CatalogPreloader.GetStatus(settings);
                if (status is null)
                {
                    return;
                }

                await InvokeAsync(() =>
                {
                    if (IsDisposed || cancellation.IsCancellationRequested
                        || !ReferenceEquals(CatalogPreloadTrackingCancellation, cancellation)
                        || !IsSameCatalog(settings, Settings)) return;
                    PreloadStatus = status;
                    StateHasChanged();
                });

                if (status.State != CatalogPreloadState.Running)
                {
                    DubboCatalogLoadResult cached = await Session.LoadServicesAsync(
                        settings,
                        forceRefresh: false,
                        cancellation.Token);
                    await InvokeAsync(() =>
                    {
                        if (IsDisposed || cancellation.IsCancellationRequested
                            || !ReferenceEquals(CatalogPreloadTrackingCancellation, cancellation)) return;
                        if (IsSameCatalog(settings, Settings))
                        {
                            Services = cached.Services.ToList();
                            SetNotice(BuildPreloadCompletionNotice(status),
                                status.State == CatalogPreloadState.Faulted);
                        }
                        CatalogStopRequested = false;
                        StateHasChanged();
                    });
                    return;
                }

                await Task.Delay(TimeSpan.FromMilliseconds(500), cancellation.Token);
            }
        }
        catch (OperationCanceledException) when (cancellation.IsCancellationRequested)
        {
            // 页面切换或设置改变时只结束当前页面的状态跟踪，后台预取继续运行。
        }
        catch (ObjectDisposedException) when (cancellation.IsCancellationRequested || IsDisposed)
        {
            // Blazor circuit 已释放。
        }
        finally
        {
            if (ReferenceEquals(CatalogPreloadTrackingCancellation, cancellation))
            {
                CatalogPreloadTrackingCancellation = null;
            }
            cancellation.Dispose();
        }
    }

    private void CancelCatalogPreloadTracking()
    {
        CancellationTokenSource? previous = CatalogPreloadTrackingCancellation;
        CatalogPreloadTrackingCancellation = null;
        previous?.Cancel();
    }

    private static bool IsSameCatalog(TesterSettings left, TesterSettings right) =>
        left.RegistryType == right.RegistryType
        && string.Equals(left.RegistryConnectionString, right.RegistryConnectionString,
            StringComparison.Ordinal)
        && string.Equals(
            RegistryRootPaths.Parse(left.RegistryRootPath).CacheKey,
            RegistryRootPaths.Parse(right.RegistryRootPath).CacheKey,
            StringComparison.Ordinal);

    private static string BuildPreloadCompletionNotice(CatalogPreloadStatus status)
    {
        string progress = $"{status.LoadedServiceCount}/{status.TotalServiceCount} 个服务已包含方法详情";
        return status.State switch
        {
            CatalogPreloadState.Completed when status.FailedServiceCount == 0 => $"后台预取完成：{progress}",
            CatalogPreloadState.Completed => $"后台预取结束：{progress}，失败 {status.FailedServiceCount} 个，可展开服务局部刷新",
            CatalogPreloadState.Stopped => $"已手动结束后台预取：{progress}，失败 {status.FailedServiceCount} 个",
            CatalogPreloadState.TimedOut => $"后台预取超过 5 分钟，已结束：{progress}，失败 {status.FailedServiceCount} 个",
            CatalogPreloadState.ConsecutiveFailures => $"后台预取连续失败 5 次，已结束：{progress}，失败 {status.FailedServiceCount} 个",
            CatalogPreloadState.Faulted => $"后台预取失败：{status.Error ?? "未知错误"}；{progress}",
            _ => $"后台预取已结束：{progress}"
        };
    }

    private async Task ToggleServiceAsync(DubboServiceItem service)
    {
        SelectedService = service;
        string serviceKey = ServiceExpansionKey(service);
        if (!ExpandedServiceKeys.Add(serviceKey))
        {
            ExpandedServiceKeys.Remove(serviceKey);
            return;
        }

        Input.RegistryRootPath = service.RegistryRootPath;
        Input.ServiceName = service.Name;

        if (!LoadingServiceKeys.Add(serviceKey)) return;
        try
        {
            await Session.LoadServiceDetailsAsync(Settings, service, forceRefresh: true);
            SetNotice($"已刷新 {service.Name}：{service.Providers.Count} 个 Provider，{service.Methods.Count} 个方法");
        }
        catch (Exception exception) { SetNotice($"加载服务详情失败：{GetErrorMessage(exception)}", true); }
        finally { LoadingServiceKeys.Remove(serviceKey); }
    }

