        string.IsNullOrWhiteSpace(value) ? "—" : value;

    private static string FormatLoadedAt(DateTimeOffset loadedAt) =>
        loadedAt == default ? "—" : loadedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss zzz");

    private static string SerializeTypeDefinitions(MethodSignatureItem signature) =>
        JsonSerializer.Serialize(signature.TypeDefinitions, MetadataJsonOptions);

