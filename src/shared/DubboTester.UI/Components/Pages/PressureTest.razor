    private async Task AddAssertion()
    {
        BusinessAssertion.Conditions.Add(new BusinessAssertionCondition());
        await PersistPressureDraftAsync();
    }

    private async Task RemoveAssertion(BusinessAssertionCondition condition)
    {
        BusinessAssertion.Conditions.Remove(condition);
        await PersistPressureDraftAsync();
    }

    private void OpenAssertionDebugDialog()
    {
        if (BusinessAssertion.Conditions.Count == 0) return;
        AssertionDebugConfiguration = BusinessAssertion.Clone();
        ClearAssertionDebugResult();
        ShowAssertionDebugDialog = true;
    }

    private void CloseAssertionDebugDialog()
    {
        ShowAssertionDebugDialog = false;
        AssertionDebugConfiguration = null;
        ClearAssertionDebugResult();
    }

    private void ClearAssertionDebugResult()
    {
        AssertionDebugResultState = AssertionDebugState.None;
        AssertionDebugResultMessage = string.Empty;
    }

    private void EvaluateAssertionDebug()
    {
        if (AssertionDebugConfiguration is null) return;

        try
        {
            PressureTestBusinessAssertionEvaluator.Validate(AssertionDebugConfiguration);
            BusinessAssertionEvaluation evaluation = PressureTestBusinessAssertionEvaluator.Evaluate(
                AssertionDebugConfiguration,
                AssertionDebugResponse);
            AssertionDebugResultState = evaluation.Success
                ? AssertionDebugState.Success
                : AssertionDebugState.Failure;
            AssertionDebugResultMessage = evaluation.Success
                ? "模拟响应满足当前配置的业务断言。"
                : evaluation.Error ?? "模拟响应不满足当前业务断言。";
        }
        catch (ArgumentException exception)
        {
            AssertionDebugResultState = AssertionDebugState.InvalidConfiguration;
            AssertionDebugResultMessage = exception.Message;
        }
    }

