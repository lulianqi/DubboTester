    private async Task HandleLimitModeChangedAsync()
    {
        ClampStepIntervalToDuration();
        await PersistPressureDraftAsync();
    }

    private async Task HandleDurationLimitChangedAsync()
    {
        ClampStepIntervalToDuration();
        await PersistPressureDraftAsync();
    }

    private async Task HandleStepStartIntervalChangedAsync()
    {
        ClampStepIntervalToDuration();
        await PersistPressureDraftAsync();
    }

    private async Task HandleSlowThresholdChangedAsync()
    {
        SlowRequestThresholdMilliseconds = Math.Max(1, SlowRequestThresholdMilliseconds);
        SlowDistributionHoverIndex = null;
        RebuildDistributionBuckets();
        await PersistPressureDraftAsync();
    }

    private void ClampStepIntervalToDuration()
    {
        if (LimitMode == PressureTestLimitMode.Duration
            && DurationLimitSeconds >= 0
            && StepStartIntervalSeconds > DurationLimitSeconds)
        {
            StepStartIntervalSeconds = DurationLimitSeconds;
        }
    }

    private async Task PersistPressureDraftAsync()
    {
        if (!DraftStorageReady || IsRunning) return;

        var draft = new PressureTestPageDraft
        {
            Invocation = Input.Clone(),
            UserCount = UserCount,
            LimitMode = LimitMode,
            IterationsPerUser = IterationsPerUser,
            DurationLimitSeconds = DurationLimitSeconds,
            UserStartIntervalMs = UserStartIntervalMs,
            StepStartIntervalSeconds = StepStartIntervalSeconds,
            StepUserCount = StepUserCount,
            RequestIntervalMs = RequestIntervalMs,
            SlowRequestThresholdMilliseconds = SlowRequestThresholdMilliseconds,
            RecordRequestResponse = RecordRequestResponse,
            BusinessAssertion = BusinessAssertion.Clone()
        };

        try
        {
            await JS.InvokeVoidAsync(
                "dubboTester.indexedDb.savePressureDraft",
                JsonSerializer.Serialize(draft, StorageJsonOptions));
            await JS.InvokeVoidAsync(
                "dubboTester.save",
                SettingsStorageKey,
                JsonSerializer.Serialize(Settings, StorageJsonOptions));
        }
        catch (JSException exception)
        {
            SetNotice($"保存压测草稿失败：{GetErrorMessage(exception)}", true);
        }
    }

    private string BuildPolyline(
        Func<PressureTestPoint, int, double> selector,
        double zoom,
        double? scaleMaximum = null)
    {
        IReadOnlyList<PressureTestPoint> points = Snapshot.Timeline;
        if (points.Count == 0) return string.Empty;
        double maximum = scaleMaximum ?? points.Select(selector).DefaultIfEmpty(0).Max();
        maximum = Math.Max(maximum, 1);
        return string.Join(' ', points.Select((point, index) =>
        {
            double x = ChartX(index, points.Count, zoom);
            double y = ChartY(selector(point, index), maximum);
            return $"{x.ToString("F1", CultureInfo.InvariantCulture)},{y.ToString("F1", CultureInfo.InvariantCulture)}";
        }));
    }

    private void RebuildDistributionBuckets()
    {
        DistributionBuckets = Snapshot.IsRunning
            ? Snapshot.DistributionBuckets
            : PressureTestDistributionBuilder.Build(
                Snapshot.RequestResults,
                Snapshot.ElapsedSeconds,
                SlowRequestThresholdMilliseconds);
        if (ErrorDistributionHoverIndex is int errorIndex && errorIndex >= DistributionBuckets.Count)
            ErrorDistributionHoverIndex = null;
        if (SlowDistributionHoverIndex is int slowIndex && slowIndex >= DistributionBuckets.Count)
            SlowDistributionHoverIndex = null;
    }

    private string BuildDistributionPolyline(
        Func<PressureTestDistributionBucket, double> selector)
    {
        if (DistributionBuckets.Count == 0) return string.Empty;
        return string.Join(' ', DistributionBuckets.Select((bucket, index) =>
            $"{SvgNumber(DistributionX(index))},{SvgNumber(ChartY(selector(bucket), 100))}"));
    }

    private double DistributionBarX(int index) =>
        DistributionX(index) - DistributionBarWidth / 2;

    private double DistributionX(int index) =>
        ChartX((index + .5) / Math.Max(DistributionBuckets.Count, 1), 1);

    private double DistributionHitStart(int index) =>
        ChartX(index / (double)Math.Max(DistributionBuckets.Count, 1), 1);

    private double DistributionHitWidth =>
        (ChartPlotRight(1) - ChartPlotLeft(1)) / Math.Max(DistributionBuckets.Count, 1);

    private string FormatDistributionTimelineTime(double ratio)
    {
        if (DistributionBuckets.Count == 0) return "--:--:--";
        double start = DistributionBuckets[0].StartedAtSeconds;
        double end = DistributionBuckets[^1].EndedAtSeconds;
        return FormatClockTime(start + Math.Clamp(ratio, 0, 1) * (end - start));
    }

    private string FormatDistributionBucketTime(PressureTestDistributionBucket bucket) =>
        $"{FormatClockTime(bucket.StartedAtSeconds)}–{FormatClockTime(bucket.EndedAtSeconds)}";

    private string DistributionTooltipStyle(int index)
    {
        double percentage = DistributionX(index) * 100 / ChartViewWidth;
        return $"left:{percentage.ToString("F2", CultureInfo.InvariantCulture)}%";
    }

    private string DistributionTooltipAlignmentClass(int index)
    {
        double percentage = DistributionX(index) * 100 / ChartViewWidth;
        return percentage < 18 ? "align-left" : percentage > 82 ? "align-right" : string.Empty;
    }

    private double SelectedPeakTps => PressureTestChartMetrics.CalculatePeakSmoothedTps(
        Snapshot.Timeline,
        ThroughputSmoothingSeconds);

    private double SmoothedTpsAt(int index) => PressureTestChartMetrics.CalculateSmoothedTps(
        Snapshot.Timeline,
        index,
        ThroughputSmoothingSeconds);

    private double ThroughputScaleMaximum => Math.Max(
        1,
        Snapshot.Timeline.Select((_, index) => SmoothedTpsAt(index)).DefaultIfEmpty(0).Max());

    private double LatencyScaleMaximum => Math.Max(
        1,
        Snapshot.Timeline.Count == 0
            ? 0
            : Snapshot.Timeline.Max(point => Math.Max(
                LatencyAverage(point),
                Math.Max(LatencyP95(point), LatencyP99(point)))));

    private double LatencyAverage(PressureTestPoint point) => LatencyMode == LatencyTrendMode.Recent
        ? point.RecentAverageMilliseconds
        : point.AverageMilliseconds;

    private double LatencyP95(PressureTestPoint point) => LatencyMode == LatencyTrendMode.Recent
        ? point.RecentP95Milliseconds
        : point.P95Milliseconds;

    private double LatencyP99(PressureTestPoint point) => LatencyMode == LatencyTrendMode.Recent
        ? point.RecentP99Milliseconds
        : point.P99Milliseconds;

    private string LatencyModeLabel => LatencyMode == LatencyTrendMode.Recent
        ? "最近 5 秒"
        : "累计";

    private double ActiveUserScaleMaximum => Math.Max(
        1,
        _lastRunConfiguration?.UserCount ?? UserCount);

