    private void ChangeChartZoom(ChartKind chart, double change)
    {
        if (chart == ChartKind.Throughput)
        {
            ThroughputZoom = Math.Clamp(
                ThroughputZoom + change,
                MinimumChartZoom,
                MaximumChartZoom);
            ThroughputHoverIndex = null;
        }
        else
        {
            LatencyZoom = Math.Clamp(
                LatencyZoom + change,
                MinimumChartZoom,
                MaximumChartZoom);
            LatencyHoverIndex = null;
        }
    }

    private static string ChartCanvasStyle(double zoom) =>
        $"width:{(zoom * 100).ToString("F0", CultureInfo.InvariantCulture)}%";

    private static double ChartPlotLeft(double zoom) => ChartLeftMargin / zoom;

    private static double ChartPlotRight(double zoom) =>
        ChartViewWidth - (ChartRightMargin / zoom);

    private static double ChartYAxisLabelX(double zoom) =>
        ChartPlotLeft(zoom) - (7 / zoom);

    private static double ChartX(double ratio, double zoom) =>
        ChartPlotLeft(zoom)
        + Math.Clamp(ratio, 0, 1) * (ChartPlotRight(zoom) - ChartPlotLeft(zoom));

    private static double ChartX(int index, int count, double zoom) =>
        count <= 1
            ? ChartX(.5, zoom)
            : ChartX(index / (double)(count - 1), zoom);

    private static double ChartY(double value, double maximum) =>
        ChartPlotBottom
        - Math.Clamp(value / Math.Max(maximum, 1), 0, 1) * (ChartPlotBottom - ChartPlotTop);

    private static double ChartHitStart(int index, int count, double zoom)
    {
        if (count <= 1) return ChartPlotLeft(zoom);
        double halfWidth = (ChartPlotRight(zoom) - ChartPlotLeft(zoom)) / (2 * (count - 1));
        return Math.Max(ChartPlotLeft(zoom), ChartX(index, count, zoom) - halfWidth);
    }

    private static double ChartHitWidth(int index, int count, double zoom)
    {
        if (count <= 1) return ChartPlotRight(zoom) - ChartPlotLeft(zoom);
        double halfWidth = (ChartPlotRight(zoom) - ChartPlotLeft(zoom)) / (2 * (count - 1));
        double start = Math.Max(ChartPlotLeft(zoom), ChartX(index, count, zoom) - halfWidth);
        double end = Math.Min(ChartPlotRight(zoom), ChartX(index, count, zoom) + halfWidth);
        return end - start;
    }

    private string TooltipStyle(int index, double zoom)
    {
        double percentage = ChartX(index, Snapshot.Timeline.Count, zoom) * 100 / ChartViewWidth;
        return $"left:{percentage.ToString("F2", CultureInfo.InvariantCulture)}%";
    }

    private string TooltipAlignmentClass(int index, double zoom)
    {
        double percentage = ChartX(index, Snapshot.Timeline.Count, zoom) * 100 / ChartViewWidth;
        return percentage < 18 ? "align-left" : percentage > 82 ? "align-right" : string.Empty;
    }

    private static double HoverPointRadiusX(double zoom) =>
        ChartHoverPointRadius / Math.Max(zoom, MinimumChartZoom);

    private static string AxisTextTransform(double x, double zoom)
    {
        double inverseZoom = 1 / Math.Max(zoom, MinimumChartZoom);
        return $"translate({SvgNumber(x)} 0) scale({SvgNumber(inverseZoom)} 1) translate({SvgNumber(-x)} 0)";
    }

    private static MarkupString AxisLabel(
        string className,
        double x,
        double y,
        string textAnchor,
        double zoom,
        string label) => new(
            $"<text class=\"{WebUtility.HtmlEncode(className)}\" "
            + $"x=\"{SvgNumber(x)}\" y=\"{SvgNumber(y)}\" "
            + $"text-anchor=\"{WebUtility.HtmlEncode(textAnchor)}\" "
            + "style=\"fill:#8490a0;font-size:8px;dominant-baseline:middle;pointer-events:none\" "
            + $"transform=\"{AxisTextTransform(x, zoom)}\">"
            + $"{WebUtility.HtmlEncode(label)}</text>");

    private string FormatTimelineTime(double ratio)
    {
        if (Snapshot.Timeline.Count == 0) return "--:--:--";
        double first = Snapshot.Timeline[0].ElapsedSeconds;
        double last = Snapshot.Timeline[^1].ElapsedSeconds;
        return FormatClockTime(first + Math.Clamp(ratio, 0, 1) * (last - first));
    }

    private static string FormatAxisValue(double value, string unit)
    {
        string number = value switch
        {
            >= 1_000 => value.ToString("N0", CultureInfo.InvariantCulture),
            >= 100 => value.ToString("F0", CultureInfo.InvariantCulture),
            >= 10 => value.ToString("F1", CultureInfo.InvariantCulture),
            _ => value.ToString("F2", CultureInfo.InvariantCulture)
        };
        return $"{number} {unit}";
    }

    private static string SvgNumber(double value) => value.ToString("F2", CultureInfo.InvariantCulture);

    private static string SanitizeFileName(string value)
    {
        string sanitized = string.Concat(value.Select(character =>
            char.IsLetterOrDigit(character) || character is '.' or '-' or '_'
                ? character
                : '-'));
        sanitized = sanitized.Trim('-');
        if (string.IsNullOrWhiteSpace(sanitized)) sanitized = "report";
        return sanitized.Length <= 80 ? sanitized : sanitized[..80];
    }

    private static string FormatMilliseconds(double value) => $"{value:F2} ms";
    private void SetNotice(string text, bool isError = false) { Notice = text; NoticeIsError = isError; }
    private static string GetErrorMessage(Exception exception)
    {
        Exception current = exception;
        while (current.InnerException is not null) current = current.InnerException;
        return current.Message;
    }

