    private async Task FormatTemplate()
    {
        try
        {
            Input.RequestJson = PressureTestTemplateResolver.FormatJsonTemplate(Input.RequestJson);
            await PersistPressureDraftAsync();
            SetNotice("参数模板已格式化");
