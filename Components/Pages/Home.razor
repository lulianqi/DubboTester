    private MethodSignatureItem? SelectedSignature =>
        SelectedSignatureIndex >= 0 && SelectedSignatureIndex < Signatures.Count
            ? Signatures[SelectedSignatureIndex]
            : null;
    private bool HasParameterStructure =>
        DubboTypeStructureBuilder.HasDetailedStructure(ParameterStructures);
    private bool CanGenerateRequestExample => ParameterStructures.Count > 0;
    private bool IsCatalogPreloading =>
        PreloadStatus?.State == CatalogPreloadState.Running;
    private bool IsCatalogActive => IsCatalogBusy || IsCatalogPreloading;
    private string CatalogNotice => IsCatalogPreloading
        ? CatalogStopRequested
            ? "正在结束后台方法预取，已完成的数据会保留…"
            : $"正在后台预取服务方法：{PreloadStatus!.LoadedServiceCount}/{PreloadStatus.TotalServiceCount}，"
              + $"失败 {PreloadStatus.FailedServiceCount}，剩余 {PreloadStatus.PendingServiceCount}"
        : Notice;

    private IEnumerable<DubboServiceItem> FilteredServices
    {
        get
        {
            if (string.IsNullOrWhiteSpace(SearchText))
            {
                return Services;
            }

            StringComparison comparison = Settings.CaseSensitiveSearch
                ? StringComparison.Ordinal
                : StringComparison.OrdinalIgnoreCase;
            return Services.Where(service =>
                (!Settings.SearchMethodsOnly && service.Name.Contains(SearchText, comparison))
                || service.Methods.Any(method => method.Contains(SearchText, comparison)));
        }
    }

    private IEnumerable<IGrouping<string, DubboServiceItem>> FilteredServiceGroups =>
        FilteredServices
            .GroupBy(service => service.RegistryRootPath, StringComparer.Ordinal)
            .OrderBy(group => group.Key, StringComparer.Ordinal);

    private IEnumerable<InvocationHistory> VisibleHistory =>
        FavoritesOnly ? History.Where(item => item.Favorite) : History;

    private string ProviderTestClass => ProviderTestSucceeded switch
    {
        true => "connected",
        false => "disconnected",
        _ => string.Empty
    };

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        try
        {
            string? settingsJson = await JS.InvokeAsync<string?>("dubboTester.load", SettingsStorageKey);
            string? historyJson = await JS.InvokeAsync<string?>("dubboTester.load", HistoryStorageKey);
            string? requestDraftsJson = await JS.InvokeAsync<string?>("dubboTester.loadSession", RequestDraftStorageKey);
            string? historyCollapsed = await JS.InvokeAsync<string?>("dubboTester.load", HistoryCollapsedStorageKey);
            bool hasPressureDraft = PressureDraft.TryGet(
                out TesterSettings pressureSettings,
                out InvocationInput pressureInvocation);
            Settings = hasPressureDraft
                ? pressureSettings
                : DeserializeOrDefault(settingsJson, new TesterSettings());
            if (hasPressureDraft) Input = pressureInvocation;
            History = DeserializeOrDefault(historyJson, new List<InvocationHistory>());
            RequestDrafts = DeserializeOrDefault(
                requestDraftsJson,
                new Dictionary<string, string>(StringComparer.Ordinal));
            HistoryCollapsed = bool.TryParse(historyCollapsed, out bool collapsed) && collapsed;
            Settings.HistoryLimit = HistoryRetentionPolicy.NormalizeLimit(Settings.HistoryLimit);
            bool historyTrimmed = HistoryRetentionPolicy.TrimToLimit(
                History,
                Settings.HistoryLimit);
            SettingsDraft = Settings.Clone();
            await JS.InvokeVoidAsync(
                "dubboTester.initializeCatalogResize",
                ".workspace",
                ".catalog-resizer",
                CatalogWidthStorageKey);
            StateHasChanged();
            if (historyTrimmed)
            {
                await PersistHistoryAsync();
            }

            if (!string.IsNullOrWhiteSpace(Settings.ZooKeeperAddress))
            {
                await RefreshCatalogAsync(false);
            }
        }
        catch (Exception exception)
        {
            SetNotice($"读取本地设置失败：{exception.Message}", true);
            StateHasChanged();
        }
    }

    private static T DeserializeOrDefault<T>(string? json, T fallback)
    {
        if (string.IsNullOrWhiteSpace(json)) return fallback;
        try { return JsonSerializer.Deserialize<T>(json, StorageJsonOptions) ?? fallback; }
        catch (JsonException) { return fallback; }
    }

    private async Task RefreshCatalogAsync(bool forceRefresh = false)
    {
        if (IsCatalogBusy) return;
        CancelCatalogPreloadTracking();
        PreloadStatus = null;
        var cancellation = new CancellationTokenSource();
        CatalogLoadCancellation = cancellation;
        CatalogStopRequested = false;
        IsCatalogBusy = true;
        SetNotice(forceRefresh
            ? "正在忽略缓存并重新读取 ZooKeeper 服务目录…"
            : "正在加载服务目录（优先使用全局缓存）…");
        try
        {
            DubboCatalogLoadResult result = await Session.LoadServicesAsync(
                Settings,
                forceRefresh,
                cancellation.Token);
            Services = result.Services.ToList();
            SelectedService = null;
            ExpandedService = null;
            await InvokeAsync(StateHasChanged);

            if (Settings.PreloadAllServiceMethods
                && !result.HasAllServiceDetails
                && !result.PreloadAttempted)
            {
                PreloadStatus = CatalogPreloader.StartOrGet(Settings, result.Services);
                StartCatalogPreloadTracking(Settings.Clone());
            }

            string source = result.FromCache ? "全局缓存" : "ZooKeeper";
            if (IsCatalogPreloading)
            {
                SetNotice(
                    $"已从{source}加载 {Services.Count} 个服务，Provider 与方法正在后台预取");
            }
            else if (Settings.PreloadAllServiceMethods && !result.HasAllServiceDetails)
            {
                SetNotice(
                    $"已从{source}加载 {Services.Count} 个服务；因 ZooKeeper 超时或连接波动，"
                    + $"仍有 {result.PendingServiceDetailCount} 个服务未预取，可展开服务重试或强制刷新");
            }
            else
            {
                if (Services.Count == 0
                    && RegistryRootPaths.Parse(Settings.RegistryRootPath).AutoDiscover)
                {
                    SetNotice("已扫描 ZooKeeper 一级节点，但未发现包含可用 Provider 的 Dubbo 注册目录", true);
                    return;
                }
                string details = result.HasAllServiceDetails ? "，已包含全部服务方法" : string.Empty;
                string roots = result.RegistryRoots.Count > 1
                    ? $"，来自 {result.RegistryRoots.Count} 个注册目录"
                    : string.Empty;
                SetNotice($"已就绪：从{source}加载 {Services.Count} 个 Dubbo 服务{roots}{details}");
            }
        }
        catch (OperationCanceledException) when (cancellation.IsCancellationRequested)
        {
            if (Services.Count > 0)
            {
                try
                {
                    DubboCatalogLoadResult cached = await Session.LoadServicesAsync(Settings);
                    Services = cached.Services.ToList();
                }
                catch
                {
                    // 保留当前已经显示的目录；结束操作不应再触发新的错误提示。
                }
            }
            SetNotice(Services.Count == 0
                ? "已手动结束服务目录加载"
                : $"已手动结束加载，已保留当前 {Services.Count} 个服务及成功预取的方法");
        }
        catch (Exception exception) { SetNotice($"加载注册中心失败：{GetErrorMessage(exception)}", true); }
        finally
        {
            IsCatalogBusy = false;
            if (ReferenceEquals(CatalogLoadCancellation, cancellation))
            {
                CatalogLoadCancellation = null;
            }
            cancellation.Dispose();

            // 首次目录加载由 OnAfterRenderAsync 发起。该生命周期方法完成后 Blazor
            // 不会自动再次渲染，因此必须在提示文案和忙碌状态都提交后显式刷新，
            // 否则页面会一直停留在“正在加载”，直到下一次用户交互。
            if (!IsDisposed)
            {
                await InvokeAsync(StateHasChanged);
            }
        }
    }

    private void StopCatalogLoad()
    {
        CatalogStopRequested = true;
        if (IsCatalogBusy && CatalogLoadCancellation is not null)
        {
            SetNotice("正在结束服务目录加载，已完成的数据会保留…");
            CatalogLoadCancellation.Cancel();
            return;
        }

        if (IsCatalogPreloading)
        {
            CatalogPreloader.Stop(Settings.ZooKeeperAddress, Settings.RegistryRootPath);
            SetNotice("正在结束后台方法预取，已完成的数据会保留…");
        }
    }

    private void StartCatalogPreloadTracking(TesterSettings settings)
    {
        CancelCatalogPreloadTracking();
        var cancellation = new CancellationTokenSource();
        CatalogPreloadTrackingCancellation = cancellation;
        _ = TrackCatalogPreloadAsync(settings, cancellation);
    }

    private async Task TrackCatalogPreloadAsync(
        TesterSettings settings,
        CancellationTokenSource cancellation)
    {
        try
        {
            while (!cancellation.IsCancellationRequested)
            {
                CatalogPreloadStatus? status = CatalogPreloader.GetStatus(
                    settings.ZooKeeperAddress,
                    settings.RegistryRootPath);
                if (status is null)
                {
                    return;
                }

                await InvokeAsync(() =>
                {
                    if (IsDisposed) return;
                    PreloadStatus = status;
                    StateHasChanged();
                });

                if (status.State != CatalogPreloadState.Running)
                {
                    DubboCatalogLoadResult cached = await Session.LoadServicesAsync(
                        settings,
                        forceRefresh: false,
                        cancellation.Token);
                    await InvokeAsync(() =>
                    {
                        if (IsDisposed) return;
                        if (IsSameCatalog(settings, Settings))
                        {
                            Services = cached.Services.ToList();
                            SetNotice(BuildPreloadCompletionNotice(status),
                                status.State == CatalogPreloadState.Faulted);
                        }
                        CatalogStopRequested = false;
                        StateHasChanged();
                    });
                    return;
                }

                await Task.Delay(TimeSpan.FromMilliseconds(500), cancellation.Token);
            }
        }
        catch (OperationCanceledException) when (cancellation.IsCancellationRequested)
        {
            // 页面切换或设置改变时只结束当前页面的状态跟踪，后台预取继续运行。
        }
        catch (ObjectDisposedException) when (cancellation.IsCancellationRequested || IsDisposed)
        {
            // Blazor circuit 已释放。
        }
        finally
        {
            if (ReferenceEquals(CatalogPreloadTrackingCancellation, cancellation))
            {
                CatalogPreloadTrackingCancellation = null;
            }
            cancellation.Dispose();
        }
    }

    private void CancelCatalogPreloadTracking()
    {
        CatalogPreloadTrackingCancellation?.Cancel();
    }

    private static bool IsSameCatalog(TesterSettings left, TesterSettings right) =>
        string.Equals(left.ZooKeeperAddress.Trim(), right.ZooKeeperAddress.Trim(),
            StringComparison.OrdinalIgnoreCase)
        && string.Equals(
            RegistryRootPaths.Parse(left.RegistryRootPath).CacheKey,
            RegistryRootPaths.Parse(right.RegistryRootPath).CacheKey,
            StringComparison.Ordinal);

    private static string BuildPreloadCompletionNotice(CatalogPreloadStatus status)
    {
        string progress = $"{status.LoadedServiceCount}/{status.TotalServiceCount} 个服务已包含方法详情";
        return status.State switch
        {
            CatalogPreloadState.Completed when status.FailedServiceCount == 0 => $"后台预取完成：{progress}",
            CatalogPreloadState.Completed => $"后台预取结束：{progress}，失败 {status.FailedServiceCount} 个，可展开服务局部刷新",
            CatalogPreloadState.Stopped => $"已手动结束后台预取：{progress}，失败 {status.FailedServiceCount} 个",
            CatalogPreloadState.TimedOut => $"后台预取超过 5 分钟，已结束：{progress}，失败 {status.FailedServiceCount} 个",
            CatalogPreloadState.ConsecutiveFailures => $"后台预取连续失败 5 次，已结束：{progress}，失败 {status.FailedServiceCount} 个",
            CatalogPreloadState.Faulted => $"后台预取失败：{status.Error ?? "未知错误"}；{progress}",
            _ => $"后台预取已结束：{progress}"
        };
    }

    private async Task ToggleServiceAsync(DubboServiceItem service)
    {
        SelectedService = service;
        if (ReferenceEquals(ExpandedService, service)) { ExpandedService = null; return; }
        ExpandedService = service;
        Input.RegistryRootPath = service.RegistryRootPath;
        Input.ServiceName = service.Name;

        IsServiceBusy = true;
        try
        {
            await Session.LoadServiceDetailsAsync(Settings, service, forceRefresh: true);
            SetNotice($"已刷新 {service.Name}：{service.Providers.Count} 个 Provider，{service.Methods.Count} 个方法");
        }
        catch (Exception exception) { SetNotice($"加载服务详情失败：{GetErrorMessage(exception)}", true); }
        finally { IsServiceBusy = false; }
    }

    private void SelectProvider(DubboProviderItem provider)
    {
        SelectedProvider = provider;
        Input.Host = provider.Host;
        Input.Port = provider.Port;
        Input.RegistryRootPath = SelectedService?.RegistryRootPath ?? Input.RegistryRootPath;
        Input.ServiceName = provider.ServiceName;
        Input.Version = provider.Version ?? string.Empty;
        Input.Group = provider.Group ?? string.Empty;
        ProviderTestSucceeded = null;
        SetNotice($"已选择 Provider {provider.Description}");
    }

    private async Task SelectMethodAsync(DubboServiceItem service, string method)
    {
        await PersistCurrentRequestDraftAsync();
        SelectedService = service;
        Input.RegistryRootPath = service.RegistryRootPath;
        Input.ServiceName = service.Name;
        Input.MethodName = method;
        Input.JavaParameterTypes = string.Empty;
        Input.Version = string.Empty;
        Input.Group = string.Empty;
        SelectedProvider = null;
        Signatures = [];
        ParameterStructures = [];
        SignatureReadFailed = false;
        TypeStructureVisible = false;
        SignatureInfoVisible = false;
        SelectedSignatureIndex = 0;
        await LoadSignaturesAsync(false);
    }

    private async Task LoadSignaturesAsync(bool showInformationOnSuccess)
    {
        if (IsSignatureBusy || string.IsNullOrWhiteSpace(Input.ServiceName) || string.IsNullOrWhiteSpace(Input.MethodName)) return;
        if (showInformationOnSuccess) SignatureInfoVisible = false;
        IsSignatureBusy = true;
        SignatureReadFailed = false;
        try
        {
            Signatures = (await Session.LoadMethodSignaturesAsync(
                Settings,
                Input.ServiceName.Trim(),
                Input.MethodName.Trim(),
                Input.RegistryRootPath)).ToList();
            SelectedSignatureIndex = 0;
            if (Signatures.Count > 0)
            {
                await ApplySignatureAsync(Signatures[0]);
                SetNotice($"已取得 {Signatures.Count} 个方法签名（来源：{Signatures[0].Source}）");
                if (showInformationOnSuccess) SignatureInfoVisible = true;
            }
            else
            {
                MarkSignatureReadFailed();
                SetWarning("未发现该方法的签名。请在下方手动填写精确 Java 参数类型后继续发送；多个类型用英文逗号分隔。");
            }
        }
        catch (Exception exception)
        {
            Signatures = [];
            ParameterStructures = [];
            TypeStructureVisible = false;
            SignatureInfoVisible = false;
            MarkSignatureReadFailed();
            SetWarning(
                $"未能自动读取方法签名。请在下方手动填写精确 Java 参数类型后继续发送；"
                + $"多个类型用英文逗号分隔。详情：{GetErrorMessage(exception)}");
        }
        finally { IsSignatureBusy = false; }
    }

    private async Task SignatureChanged(ChangeEventArgs args)
    {
        if (!int.TryParse(args.Value?.ToString(), out int index) || index < 0 || index >= Signatures.Count) return;
        await PersistCurrentRequestDraftAsync();
        SelectedSignatureIndex = index;
        await ApplySignatureAsync(Signatures[index]);
    }

    private async Task ApplySignatureAsync(MethodSignatureItem signature)
    {
        SignatureReadFailed = false;
        Input.JavaParameterTypes = string.Join(", ", signature.ParameterTypes);
        Input.Version = signature.Version ?? Input.Version;
        Input.Group = signature.Group ?? Input.Group;
        ParameterStructures = DubboTypeStructureBuilder.Build(signature);
        if (!HasParameterStructure) TypeStructureVisible = false;
        await RestoreCurrentRequestDraftAsync();
    }

    private void MarkSignatureReadFailed()
    {
        SignatureReadFailed = true;
        Input.Version = string.Empty;
        Input.Group = string.Empty;
    }

    private void OpenTypeStructure()
    {
        if (HasParameterStructure) TypeStructureVisible = true;
    }

    private void CloseTypeStructure() => TypeStructureVisible = false;

    private void CloseSignatureInfo() => SignatureInfoVisible = false;

    private static string DisplayMetadataValue(string? value) =>
        string.IsNullOrWhiteSpace(value) ? "—" : value;

    private static string FormatLoadedAt(DateTimeOffset loadedAt) =>
        loadedAt == default ? "—" : loadedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss zzz");

    private static string SerializeTypeDefinitions(MethodSignatureItem signature) =>
        JsonSerializer.Serialize(signature.TypeDefinitions, MetadataJsonOptions);

    private async Task GenerateRequestExample()
    {
        if (!CanGenerateRequestExample) return;
        Input.RequestJson = DubboTypeStructureBuilder.GenerateExampleJson(ParameterStructures);
        await PersistCurrentRequestDraftAsync();
        TypeStructureVisible = false;
        SetNotice("已根据 Java 参数类型和元数据结构生成请求 JSON 示例，请按实际业务含义修改字段值");
    }

    private async Task TestProviderAsync()
    {
        IsProviderTesting = true;
        ProviderTestSucceeded = null;
        try
        {
            await DubboSession.TestProviderAsync(Input.Host, Input.Port, Settings.RequestTimeoutMs);
            ProviderTestSucceeded = true;
            SetNotice($"Provider {Input.Host}:{Input.Port} TCP 连接成功");
        }
        catch (Exception exception)
        {
            ProviderTestSucceeded = false;
            SetNotice($"Provider 连接失败：{GetErrorMessage(exception)}", true);
        }
        finally { IsProviderTesting = false; }
    }

    private async Task InvokeAsync()
    {
        if (IsInvoking) return;
        await PersistCurrentRequestDraftAsync();
        IsInvoking = true;
        LastOutput = null;
        ResultText = string.Empty;
        SetNotice($"正在调用 {Input.ServiceName}#{Input.MethodName}…");
        try
        {
            LastOutput = await Session.InvokeAsync(Settings, Input);
            ResultText = LastOutput.Success ? LastOutput.Content : LastOutput.Error ?? "Dubbo 请求失败，未返回错误详情。";
            SetNotice(LastOutput.Success ? $"调用成功，用时 {LastOutput.RequestElapsed} ms" : $"调用失败：{LastOutput.Error}", !LastOutput.Success);
            AddHistory(LastOutput);
            await PersistHistoryAsync();
        }
        catch (Exception exception)
        {
            string message = GetErrorMessage(exception);
            LastOutput = new InvocationOutput { Success = false, Error = message };
            ResultText = message;
            SetNotice($"调用失败：{message}", true);
            if (!string.IsNullOrWhiteSpace(Input.ServiceName)
                && !string.IsNullOrWhiteSpace(Input.MethodName))
            {
                AddHistory(LastOutput);
                await PersistHistoryAsync();
            }
        }
        finally { IsInvoking = false; }
    }

    private async Task OpenPressureTest()
    {
        if (IsInvoking) return;
        await PersistCurrentRequestDraftAsync();
        PressureDraft.Capture(Settings, Input);
        Navigation.NavigateTo("/pressure-test");
    }

    private void AddHistory(InvocationOutput output)
    {
        History.Insert(0, new InvocationHistory
        {
            Success = output.Success,
            Route = Input.Route,
            RegistryRootPath = Input.RegistryRootPath,
            ServiceName = Input.ServiceName,
            MethodName = Input.MethodName,
            Host = Input.Host,
            Port = Input.Port,
            RequestJson = Input.RequestJson,
            JavaParameterTypes = Input.JavaParameterTypes,
            Version = Input.Version,
            Group = Input.Group,
            AttachmentsJson = Input.AttachmentsJson,
            Response = Settings.SaveResponseInHistory ? ResultText : string.Empty,
            ElapsedMs = output.RequestElapsed
        });
        HistoryRetentionPolicy.TrimToLimit(History, Settings.HistoryLimit);
    }

    private async Task LoadHistoryAsync(InvocationHistory item)
    {
        await PersistCurrentRequestDraftAsync();
        Signatures = [];
        ParameterStructures = [];
        SignatureReadFailed = false;
        TypeStructureVisible = false;
        SignatureInfoVisible = false;
        Input.Route = item.Route;
        Input.RegistryRootPath = item.RegistryRootPath;
        Input.ServiceName = item.ServiceName;
        Input.MethodName = item.MethodName;
        Input.Host = item.Host;
        Input.Port = item.Port;
        Input.RequestJson = item.RequestJson;
        Input.JavaParameterTypes = item.JavaParameterTypes;
        Input.Version = item.Version;
        Input.Group = item.Group;
        Input.AttachmentsJson = item.AttachmentsJson;
        await PersistCurrentRequestDraftAsync();
        if (!string.IsNullOrWhiteSpace(item.Response))
        {
            ResultText = item.Response;
            LastOutput = new InvocationOutput
            {
                Success = item.Success,
                Content = item.Response,
                Error = item.Success ? null : item.Response,
                RequestElapsed = item.ElapsedMs
            };
        }
        SetNotice($"已加载历史请求 {item.Endpoint}");
    }

    private async Task ToggleFavoriteAsync(InvocationHistory item) { item.Favorite = !item.Favorite; await PersistHistoryAsync(); }
    private async Task DeleteHistoryAsync(InvocationHistory item) { History.Remove(item); await PersistHistoryAsync(); }
    private async Task ClearHistoryAsync() { History.Clear(); await PersistHistoryAsync(); }

    private async Task ToggleHistoryCollapsedAsync()
    {
        HistoryCollapsed = !HistoryCollapsed;
        await JS.InvokeVoidAsync(
            "dubboTester.save",
            HistoryCollapsedStorageKey,
            HistoryCollapsed.ToString());
    }

    private void RequestJsonChanged(ChangeEventArgs args)
    {
        Input.RequestJson = args.Value?.ToString() ?? string.Empty;
    }

    private async Task PersistCurrentRequestDraftAsync()
    {
        string? key = CurrentRequestDraftKey();
        if (key is null) return;

        RequestDrafts[key] = Input.RequestJson;
        try
        {
            await JS.InvokeVoidAsync(
                "dubboTester.saveSession",
                RequestDraftStorageKey,
                JsonSerializer.Serialize(RequestDrafts, StorageJsonOptions));
        }
        catch (Microsoft.JSInterop.JSException)
        {
            // Keep the in-memory draft when sessionStorage is unavailable or full.
        }
    }

    private Task RestoreCurrentRequestDraftAsync()
    {
        string? key = CurrentRequestDraftKey();
        if (key is not null && RequestDrafts.TryGetValue(key, out string? requestJson))
        {
            Input.RequestJson = requestJson;
        }
        else
        {
            // Do not carry another method/overload's arguments into a newly selected method.
            Input.RequestJson = "{}";
        }
        return Task.CompletedTask;
    }

    private string? CurrentRequestDraftKey()
    {
        string serviceName = Input.ServiceName.Trim();
        string methodName = Input.MethodName.Trim();
        if (serviceName.Length == 0 || methodName.Length == 0) return null;

        string parameterTypes = SelectedSignature is not null
            ? string.Join(",", SelectedSignature.ParameterTypes)
            : Input.JavaParameterTypes.Trim();
        return string.Join(
            '\u001f',
            Settings.ZooKeeperAddress.Trim(),
            Input.RegistryRootPath.Trim(),
            serviceName,
            methodName,
            parameterTypes,
            Input.Version.Trim(),
            Input.Group.Trim());
    }

    private async Task FormatRequest()
    {
        try
        {
            Input.RequestJson = JsonArgumentParser.FormatArguments(Input.RequestJson);
            await PersistCurrentRequestDraftAsync();
            SetNotice("请求 JSON 已格式化");
        }
        catch (Exception exception) { SetNotice($"JSON 格式错误：{exception.Message}", true); }
    }

    private IEnumerable<string> FilterMethods(IEnumerable<string> methods)
    {
        if (string.IsNullOrWhiteSpace(SearchText) || !Settings.HideUnmatched) return methods;
        StringComparison comparison = Settings.CaseSensitiveSearch ? StringComparison.Ordinal : StringComparison.OrdinalIgnoreCase;
        return methods.Where(method => method.Contains(SearchText, comparison));
    }

    private void OpenSettings() { SettingsDraft = Settings.Clone(); SettingsVisible = true; }
    private void CloseSettings() => SettingsVisible = false;

    private async Task SaveSettingsAsync()
    {
        SettingsDraft.RegistryRootPath = SettingsDraft.RegistryRootPath.Trim();
        SettingsDraft.MetadataRootPath = SettingsDraft.MetadataRootPath.Trim();
        SettingsDraft.HistoryLimit = HistoryRetentionPolicy.NormalizeLimit(SettingsDraft.HistoryLimit);
        Settings = SettingsDraft.Clone();
        SettingsVisible = false;
        bool historyTrimmed = HistoryRetentionPolicy.TrimToLimit(History, Settings.HistoryLimit);
        await PersistSettingsAsync();
        if (historyTrimmed)
        {
            await PersistHistoryAsync();
        }
        await RefreshCatalogAsync(false);
    }

    private async Task PersistSettingsAsync() =>
        await JS.InvokeVoidAsync("dubboTester.save", SettingsStorageKey, JsonSerializer.Serialize(Settings, StorageJsonOptions));

    private async Task PersistHistoryAsync() =>
        await JS.InvokeVoidAsync("dubboTester.save", HistoryStorageKey, JsonSerializer.Serialize(History, StorageJsonOptions));

    private async Task CopyResultAsync() { await JS.InvokeVoidAsync("dubboTester.copy", ResultText); SetNotice("响应已复制到剪贴板"); }
    private async Task DownloadResultAsync() =>
        await JS.InvokeVoidAsync("dubboTester.download", $"dubbo-response-{DateTime.Now:yyyyMMdd-HHmmss}.json", ResultText);

    private void SetNotice(string message, bool isError = false)
    {
        Notice = message;
        NoticeIsError = isError;
        NoticeIsWarning = false;
    }

    private void SetWarning(string message)
    {
        Notice = message;
        NoticeIsError = false;
        NoticeIsWarning = true;
    }
    private int HistoryNumber(InvocationHistory item) { int index = History.IndexOf(item); return index < 0 ? 0 : History.Count - index; }
    private static string OneLine(string value) => value.Replace("\r", string.Empty).Replace("\n", " ").Trim();
    private static string GetErrorMessage(Exception exception)
    {
        Exception current = exception;
        while (current.InnerException is not null) current = current.InnerException;
        return current.Message;
    }

    public void Dispose()
    {
        IsDisposed = true;
        CatalogLoadCancellation?.Cancel();
        CatalogPreloadTrackingCancellation?.Cancel();
    }
}
