@page "/"
@page "/dubbo"
@page "/independent-pages/dubbo"
@using System.Text.Json
@implements IDisposable
@inject DubboSession Session
@inject DubboCatalogPreloadService CatalogPreloader
@inject PressureTestDraftStore PressureDraft
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>Dubbo Tester</PageTitle>

<div class="tester-shell">
    <header class="topbar">
        <div class="brand-block">
            <div class="brand-mark">D</div>
            <div>
                <div class="brand">Dubbo Tester</div>
                <div class="brand-subtitle">Native Dubbo2 · Hessian2</div>
            </div>
        </div>
        <div class="topbar-actions">
            <span class="package-badge">DubboNet 2.0.0</span>
            <button class="icon-button" title="设置" @onclick="OpenSettings">⚙</button>
            <button class="icon-button" title="强制刷新注册中心" disabled="@IsCatalogActive" @onclick="() => RefreshCatalogAsync(true)">
                <span class="@(IsCatalogBusy ? "spin" : null)">↻</span>
            </button>
        </div>
        <div class="notice @(NoticeIsError ? "notice-error" : NoticeIsWarning ? "notice-warning" : null)">
            <span class="notice-dot"></span>
            <span class="notice-message" title="@CatalogNotice">@CatalogNotice</span>
            @if (IsCatalogActive)
            {
                <button class="text-button notice-cancel" @onclick="StopCatalogLoad">结束加载</button>
            }
        </div>
    </header>

    <main class="workspace @(HistoryCollapsed ? "history-collapsed" : null)">
        <aside class="catalog-panel panel">
            <div class="panel-heading">
                <div>
                    <h2>服务目录</h2>
                    <span>@Services.Count 个服务</span>
                </div>
                <button class="subtle-button" title="忽略缓存并刷新" disabled="@IsCatalogActive" @onclick="() => RefreshCatalogAsync(true)">刷新</button>
            </div>

            <div class="search-box">
                <span>⌕</span>
                <input placeholder="搜索服务或方法…" @bind="SearchText" @bind:event="oninput" />
                @if (!string.IsNullOrWhiteSpace(SearchText))
                {
                    <button title="清除" @onclick="() => SearchText = string.Empty">×</button>
                }
            </div>

            @if (Services.Count == 0)
            {
                <div class="empty-state">
                    <div class="empty-icon">⌘</div>
                    <strong>尚未加载服务</strong>
                    <span>配置 ZooKeeper 后刷新注册中心</span>
                    <button class="primary small" @onclick="OpenSettings">打开设置</button>
                </div>
            }
            else
            {
                <div class="service-tree">
                    <div class="tree-root"><span>▾</span><b>/</b></div>
                    @foreach (IGrouping<string, DubboServiceItem> registryGroup in FilteredServiceGroups)
                    {
                        <div class="tree-root tree-indent" title="@registryGroup.Key">
                            <span>▾</span><b>@RegistryRootPaths.DisplayName(registryGroup.Key)</b>
                        </div>
                        @foreach (DubboServiceItem service in registryGroup)
                        {
                            <div class="service-node @(ReferenceEquals(SelectedService, service) ? "active-service" : null)"
                                 @key="service">
                                <button class="service-row" @onclick="() => ToggleServiceAsync(service)">
                                    <span class="chevron">@(ReferenceEquals(ExpandedService, service) ? "▾" : "›")</span>
                                    <span class="service-icon">⬡</span>
                                    <span class="service-name" title="@service.Name">@service.Name</span>
                                    @if (service.IsLoaded)
                                    {
                                        <span class="count-pill">@service.Methods.Count</span>
                                    }
                                </button>

                                @if (ReferenceEquals(ExpandedService, service))
                                {
                                    <div class="service-children">
                                        @if (IsServiceBusy)
                                        {
                                            <div class="loading-row"><span class="spinner"></span>加载 Provider…</div>
                                        }
                                        else if (service.IsLoaded)
                                        {
                                            @foreach (DubboProviderItem provider in service.Providers)
                                            {
                                                <button class="tree-item provider-item @(SelectedProvider?.RegistryUrl == provider.RegistryUrl ? "selected" : null)"
                                                        title="@provider.RegistryUrl"
                                                        @onclick="() => SelectProvider(provider)">
                                                    <span class="status-led @(provider.Disabled ? "disabled" : null)"></span>
                                                    <span>@provider.Address</span>
                                                    <small>@provider.Scheme</small>
                                                </button>
                                            }
                                            @foreach (string method in FilterMethods(service.Methods))
                                            {
                                                <button class="tree-item method-item @(Input.RegistryRootPath == service.RegistryRootPath && Input.ServiceName == service.Name && Input.MethodName == method ? "selected" : null)"
                                                        @onclick="() => SelectMethodAsync(service, method)">
                                                    <span>↪</span><span title="@method">@method</span>
                                                </button>
                                            }
                                            @if (service.Providers.Count == 0)
                                            {
                                                <div class="muted-row">没有可用 Provider</div>
                                            }
                                        }
                                    </div>
                                }
                            </div>
                        }
                    }
                    @if (!FilteredServices.Any())
                    {
                        <div class="muted-row centered">没有匹配项</div>
                    }
                </div>
            }
        </aside>

        <div class="catalog-resizer"
             role="separator"
             aria-orientation="vertical"
             aria-label="调整服务目录宽度"
             title="拖动调整服务目录宽度"></div>

        <section class="request-panel panel">
            <div class="connection-bar">
                <label class="route-switch">
                    <select @bind="Input.Route">
                        <option value="@InvocationRoute.Registry">注册中心</option>
                        <option value="@InvocationRoute.DirectProvider">直连 Provider</option>
                    </select>
                </label>
                <div class="address-field">
                    <span>主机地址</span>
                    <input placeholder="选择 Provider" @bind="Input.Host" />
                </div>
                <input class="port-field" type="number" min="1" max="65535" @bind="Input.Port" />
                <button class="connect-button @ProviderTestClass" title="检测 TCP 连通性" disabled="@IsProviderTesting" @onclick="TestProviderAsync">
                    @if (IsProviderTesting)
                    {
                        <span class="spinner"></span>
                    }
                    else
                    {
                        <span>⛓</span>
                    }
                </button>
            </div>

            <div class="endpoint-row">
                <div class="endpoint-input service-endpoint">
                    <span>服务</span>
                    <input placeholder="com.foo.DemoService" @bind="Input.ServiceName" />
                </div>
                <div class="endpoint-separator">#</div>
                <div class="endpoint-input method-endpoint">
                    <span>方法</span>
                    <input placeholder="methodName" @bind="Input.MethodName" />
                </div>
                <button class="subtle-button signature-load" disabled="@(IsSignatureBusy || string.IsNullOrWhiteSpace(Input.MethodName))" @onclick="() => LoadSignaturesAsync(true)">
                    @(IsSignatureBusy ? "加载中…" : "读取签名")
                </button>
            </div>

            <div class="signature-area">
                <div class="signature-strip @(SignatureReadFailed ? "signature-warning" : null)">
                    <span class="strip-label">Java 签名</span>
                    @if (Signatures.Count > 0)
                    {
                        <span class="signature-display"
                              title="@Signatures[SelectedSignatureIndex].Signature">
                            @Signatures[SelectedSignatureIndex].Signature
                        </span>
                        @if (Signatures.Count > 1)
                        {
                            <select class="overload-picker"
                                    aria-label="选择重载签名"
                                    title="选择重载签名"
                                    value="@SelectedSignatureIndex"
                                    @onchange="SignatureChanged">
                                @for (int index = 0; index < Signatures.Count; index++)
                                {
                                    <option value="@index">重载 @(index + 1)</option>
                                }
                            </select>
                        }
                        <span class="source-badge">@Signatures[SelectedSignatureIndex].Source</span>
                    }
                    else if (SignatureReadFailed)
                    {
                        <span class="signature-fallback">未能自动读取签名，请在下方手动填写参数类型</span>
                    }
                    else
                    {
                        <input placeholder="自动解析；也可填写 java.lang.String, java.lang.Long"
                               @bind="Input.JavaParameterTypes"
                               @bind:event="oninput" />
                    }
                </div>
                @if (SignatureReadFailed)
                {
                    <label class="manual-types-field">
                        <span>Java 参数类型</span>
                        <input @bind="Input.JavaParameterTypes"
                               @bind:event="oninput"
                               placeholder="例如：int, java.lang.String；数组：double[]；集合：java.util.List" />
                        <small>按方法参数顺序填写精确类型，多个用英文逗号分隔；对象使用完整类名，集合填写原始类型且不要带泛型。</small>
                    </label>
                }
            </div>

            <section class="editor-card request-editor">
                <div class="editor-toolbar">
                    <div>
                        <b>请求参数</b>
                        <span>JSON 参数数组；单个对象可直接填写</span>
                    </div>
                    <div class="toolbar-actions">
                        @if (HasParameterStructure)
                        {
                            <button class="text-button" @onclick="OpenTypeStructure">参数结构</button>
                        }
                        @if (CanGenerateRequestExample)
                        {
                            <button class="text-button" title="根据 Java 参数类型和元数据结构生成示例并替换当前请求内容" @onclick="GenerateRequestExample">按结构生成示例</button>
                        }
                        <button class="text-button" @onclick="FormatRequest">格式化</button>
                    </div>
                </div>
                <textarea spellcheck="false"
                          value="@Input.RequestJson"
                          @oninput="RequestJsonChanged"
                          @onchange="PersistCurrentRequestDraftAsync"></textarea>
            </section>

            <div class="action-row">
                <details class="advanced-options">
                    <summary>高级选项</summary>
                    <div class="advanced-popover">
                        <label>服务版本<input @bind="Input.Version" placeholder="可选" /></label>
                        <label>服务分组<input @bind="Input.Group" placeholder="可选" /></label>
                        <label class="wide">
                            <span>Attachments JSON <small>可选，随 RPC 请求传递，类似请求 Header</small></span>
                            <textarea @bind="Input.AttachmentsJson" placeholder='{"traceId":"..."}'></textarea>
                        </label>
                        @if (Signatures.Count > 0)
                        {
                            <label class="wide">Java 参数类型<input @bind="Input.JavaParameterTypes" @bind:event="oninput" /></label>
                        }
                    </div>
                </details>
                <div class="send-hint">
                    @if (Input.Route == InvocationRoute.Registry)
                    {
                        <span>由注册中心发现并负载均衡</span>
                    }
                    else
                    {
                        <span>直连模式需要精确 Java 类型</span>
                    }
                </div>
                <div class="split-send">
                    <button class="primary send-button split-send-main" disabled="@IsInvoking" @onclick="InvokeAsync">
                        @if (IsInvoking)
                        {
                            <span class="spinner light"></span><span>请求中</span>
                        }
                        else
                        {
                            <span>▷</span><span>发送</span>
                        }
                    </button>
                    <details class="send-more">
                        <summary title="更多发送方式" aria-label="更多发送方式">▾</summary>
                        <div class="send-more-menu">
                            <button @onclick="OpenPressureTest">
                                <span class="menu-icon">◫</span>
                                <span><b>压力测试</b><small>并发发送并查看性能指标</small></span>
                            </button>
                        </div>
                    </details>
                </div>
            </div>

            <section class="editor-card result-editor">
                <div class="editor-toolbar result-toolbar">
                    <div class="result-title">
                        <b>响应结果</b>
                        @if (LastOutput is not null)
                        {
                            <span class="result-state @(LastOutput.Success ? "success" : "failed")">
                                @(LastOutput.Success ? "成功" : "失败")
                            </span>
                            <span>@LastOutput.RequestElapsed ms</span>
                            @if (LastOutput.RequestId is not null)
                            {
                                <span>Request ID @LastOutput.RequestId</span>
                            }
                        }
                    </div>
                    <div class="toolbar-actions">
                        <button class="text-button" disabled="@string.IsNullOrEmpty(ResultText)" @onclick="CopyResultAsync">复制</button>
                        <button class="text-button" disabled="@string.IsNullOrEmpty(ResultText)" @onclick="DownloadResultAsync">下载</button>
                        <button class="text-button" disabled="@string.IsNullOrEmpty(ResultText)" @onclick="() => ResultText = string.Empty">清空</button>
                    </div>
                </div>
                <pre class="result-content @(LastOutput is { Success: false } ? "error-content" : null)">@ResultText</pre>
            </section>
        </section>

        <aside class="history-panel panel @(HistoryCollapsed ? "collapsed" : null)">
            <div class="panel-heading history-heading">
                @if (HistoryCollapsed)
                {
                    <button class="history-collapse-button expand"
                            title="展开历史记录"
                            aria-label="展开历史记录"
                            @onclick="ToggleHistoryCollapsedAsync">‹</button>
                }
                else
                {
                    <div>
                        <h2>历史记录</h2>
                        <span>@VisibleHistory.Count() 条</span>
                    </div>
                    <div class="history-actions">
                        <button class="heart-filter @(FavoritesOnly ? "active" : null)" title="只看收藏" @onclick="() => FavoritesOnly = !FavoritesOnly">♥</button>
                        <button class="subtle-button danger" disabled="@(History.Count == 0)" @onclick="ClearHistoryAsync">清空</button>
                        <button class="history-collapse-button"
                                title="折叠历史记录"
                                aria-label="折叠历史记录"
                                @onclick="ToggleHistoryCollapsedAsync">›</button>
                    </div>
                }
            </div>
            @if (!HistoryCollapsed)
            {
                <label class="save-response-setting">
                    <input type="checkbox" @bind="Settings.SaveResponseInHistory" @bind:after="PersistSettingsAsync" />
                    <span>历史中保存响应正文</span>
                </label>
                <div class="history-list">
                    @foreach (InvocationHistory item in VisibleHistory)
                    {
                        <article class="history-card @(item.Success ? null : "failed")" @key="item.Id">
                            <button class="history-main" @onclick="() => LoadHistoryAsync(item)">
                                <div class="history-meta">
                                    <span class="history-id">#@HistoryNumber(item)</span>
                                    <span>@item.CreatedAt.ToLocalTime().ToString("MM-dd HH:mm:ss")</span>
                                    <span>@item.ElapsedMs ms</span>
                                </div>
                                <strong title="@item.Endpoint">@item.Endpoint</strong>
                                <code title="@item.RequestJson">@OneLine(item.RequestJson)</code>
                            </button>
                            <div class="history-card-actions">
                                <button class="favorite @(item.Favorite ? "active" : null)" title="收藏" @onclick="() => ToggleFavoriteAsync(item)">♥</button>
                                <button title="删除" @onclick="() => DeleteHistoryAsync(item)">×</button>
                            </div>
                        </article>
                    }
                    @if (!VisibleHistory.Any())
                    {
                        <div class="empty-state compact"><span>暂无历史记录</span></div>
                    }
                </div>
            }
        </aside>
    </main>
</div>

@if (SignatureInfoVisible)
{
    <div class="modal-backdrop" @onclick="CloseSignatureInfo">
        <section class="type-structure-modal signature-info-modal" @onclick:stopPropagation="true">
            <header>
                <div>
                    <h2>读取签名结果</h2>
                    <p>@Input.ServiceName#@Input.MethodName · @Signatures.Count 个重载</p>
                </div>
                <button class="modal-close" @onclick="CloseSignatureInfo">×</button>
            </header>
            <div class="signature-info-content">
                @for (int index = 0; index < Signatures.Count; index++)
                {
                    MethodSignatureItem signature = Signatures[index];
                    <section class="signature-info-card">
                        <div class="signature-info-title">
                            <span>#@(index + 1)</span>
                            <code>@signature.Signature</code>
                        </div>
                        <dl class="metadata-grid">
                            <div><dt>服务</dt><dd>@DisplayMetadataValue(signature.ServiceName)</dd></div>
                            <div><dt>方法</dt><dd>@DisplayMetadataValue(signature.MethodName)</dd></div>
                            <div><dt>返回类型</dt><dd>@DisplayMetadataValue(signature.ReturnType)</dd></div>
                            <div><dt>参数类型</dt><dd>@DisplayMetadataValue(string.Join(", ", signature.ParameterTypes))</dd></div>
                            <div><dt>来源</dt><dd>@DisplayMetadataValue(signature.Source)</dd></div>
                            <div><dt>Provider 应用</dt><dd>@DisplayMetadataValue(signature.Application)</dd></div>
                            <div><dt>版本</dt><dd>@DisplayMetadataValue(signature.Version)</dd></div>
                            <div><dt>分组</dt><dd>@DisplayMetadataValue(signature.Group)</dd></div>
                            <div><dt>代码来源</dt><dd>@DisplayMetadataValue(signature.CodeSource)</dd></div>
                            <div><dt>元数据版本</dt><dd>@signature.MetadataVersion</dd></div>
                            <div class="metadata-wide"><dt>元数据路径</dt><dd title="@signature.MetadataPath">@DisplayMetadataValue(signature.MetadataPath)</dd></div>
                            <div class="metadata-wide"><dt>读取时间</dt><dd>@FormatLoadedAt(signature.LoadedAt)</dd></div>
                        </dl>
                        <details class="metadata-details" open="@(index == 0)">
                            <summary>服务参数（@signature.ServiceParameters.Count）</summary>
                            @if (signature.ServiceParameters.Count > 0)
                            {
                                <div class="metadata-parameters">
                                    @foreach (KeyValuePair<string, string> parameter in signature.ServiceParameters.OrderBy(item => item.Key, StringComparer.Ordinal))
                                    {
                                        <div><code>@parameter.Key</code><span>@parameter.Value</span></div>
                                    }
                                </div>
                            }
                            else
                            {
                                <p class="metadata-empty">无</p>
                            }
                        </details>
                        <details class="metadata-details">
                            <summary>原始类型定义 types（@signature.TypeDefinitions.Count）</summary>
                            <pre>@SerializeTypeDefinitions(signature)</pre>
                        </details>
                    </section>
                }
            </div>
            <footer>
                <span>以上为 DubboNet 2.0.0 本次读取到的完整方法与类型元数据。</span>
                <div><button class="primary" @onclick="CloseSignatureInfo">关闭</button></div>
            </footer>
        </section>
    </div>
}

@if (TypeStructureVisible)
{
    <div class="modal-backdrop" @onclick="CloseTypeStructure">
        <section class="type-structure-modal" @onclick:stopPropagation="true">
            <header>
                <div>
                    <h2>参数结构</h2>
                    <p title="@SelectedSignature?.Signature">@SelectedSignature?.Signature</p>
                </div>
                <button class="modal-close" @onclick="CloseTypeStructure">×</button>
            </header>
            <div class="type-structure-content">
                @foreach (MethodParameterStructure parameter in ParameterStructures)
                {
                    <section class="parameter-structure-card">
                        <div class="parameter-structure-title">
                            <b>@parameter.DisplayName</b>
                            <code>@parameter.Structure.JavaType</code>
                        </div>
                        <ul class="type-tree">
                            <TypeStructureNode Node="@parameter.Structure" />
                        </ul>
                    </section>
                }
            </div>
            <footer>
                <span>示例只用于辅助填写，请按实际业务含义修改字段值。</span>
                <div>
                    <button class="subtle-button" @onclick="CloseTypeStructure">关闭</button>
                    <button class="primary" @onclick="GenerateRequestExample">生成并填入请求 JSON</button>
                </div>
            </footer>
        </section>
    </div>
}

@if (SettingsVisible)
{
    <div class="modal-backdrop" @onclick="CloseSettings">
        <section class="settings-modal" @onclick:stopPropagation="true">
            <header>
                <div><h2>连接与页面设置</h2><p>设置会保存在当前浏览器中</p></div>
                <button class="modal-close" @onclick="CloseSettings">×</button>
            </header>
            <div class="settings-content">
                <label class="wide-field">
                    <span>ZooKeeper 连接地址<b>*</b></span>
                    <input @bind="SettingsDraft.ZooKeeperAddress" @bind:event="oninput" placeholder="zk-1:2181,zk-2:2181" />
                    <small>支持 DubboNet 的 digest 认证连接字符串格式</small>
                </label>
                <div class="settings-grid">
                    <label>
                        <span>注册目录</span>
                        <input @bind="SettingsDraft.RegistryRootPath" @bind:event="oninput" placeholder="/dubbo-a, /dubbo-b；留空或 / 自动扫描" />
                        <small>多个目录用逗号、分号或空格分隔；留空或填写 / 时自动扫描一级目录</small>
                    </label>
                    <label><span>请求超时（ms）</span><input type="number" min="100" max="600000" @bind="SettingsDraft.RequestTimeoutMs" /></label>
                </div>
                <div class="settings-grid">
                    <label><span>元数据中心地址</span><input @bind="SettingsDraft.MetadataCenterAddress" placeholder="留空则复用注册中心" /></label>
                    <label>
                        <span>元数据目录</span>
                        <input @bind="SettingsDraft.MetadataRootPath"
                               @bind:event="oninput"
                               placeholder="留空则复用当前服务的注册目录" />
                        <small>留空时随当前服务所属注册目录自动切换；填写后固定使用指定目录</small>
                    </label>
                </div>
                <div class="settings-grid">
                    <label>
                        <span>负载均衡</span>
                        <select @bind="SettingsDraft.LoadBalanceMode">
                            @foreach (DubboClient.LoadBalanceMode mode in Enum.GetValues<DubboClient.LoadBalanceMode>())
                            {
                                <option value="@mode">@mode</option>
                            }
                        </select>
                    </label>
                    <label>
                        <span>签名兜底超时（ms）</span>
                        <input type="number" min="100" max="60000" @bind="SettingsDraft.MetadataFallbackTimeoutMs" />
                        <small>仅包内部在元数据中心不可用时使用</small>
                    </label>
                </div>
                <div class="settings-grid">
                    <label>
                        <span>历史记录上限</span>
                        <input type="number"
                               min="@HistoryRetentionPolicy.MinimumLimit"
                               max="@HistoryRetentionPolicy.MaximumLimit"
                               @bind="SettingsDraft.HistoryLimit" />
                        <small>默认 500，最高 2000；自动清理时优先保留收藏记录</small>
                    </label>
                </div>
                <div class="setting-checks">
                    <label title="加载目录时一次性读取全部服务的 Provider 和方法，服务节点仍保持收起">
                        <input type="checkbox" @bind="SettingsDraft.PreloadAllServiceMethods" />加载目录时预取全部服务方法
                    </label>
                    <label><input type="checkbox" @bind="SettingsDraft.HideUnmatched" />只显示搜索匹配项</label>
                    <label><input type="checkbox" @bind="SettingsDraft.SearchMethodsOnly" />仅搜索方法名</label>
                    <label><input type="checkbox" @bind="SettingsDraft.CaseSensitiveSearch" />搜索区分大小写</label>
                    <label><input type="checkbox" @bind="SettingsDraft.SaveResponseInHistory" />历史记录保存响应正文</label>
                </div>
            </div>
            <footer>
                <button class="subtle-button" @onclick="CloseSettings">取消</button>
                <button class="primary" @onclick="SaveSettingsAsync">保存并刷新</button>
            </footer>
        </section>
    </div>
}

@code {
    private const string SettingsStorageKey = "dubbo-tester.settings.v1";
    private const string HistoryStorageKey = "dubbo-tester.history.v1";
    private const string RequestDraftStorageKey = "dubbo-tester.request-drafts.v1";
    private const string HistoryCollapsedStorageKey = "dubbo-tester.history-collapsed.v1";
    private const string CatalogWidthStorageKey = "dubbo-tester.catalog-width.v1";
    private static readonly JsonSerializerOptions StorageJsonOptions = new(JsonSerializerDefaults.Web);
    private static readonly JsonSerializerOptions MetadataJsonOptions = new(JsonSerializerDefaults.Web)
    {
        WriteIndented = true,
        Encoder = System.Text.Encodings.Web.JavaScriptEncoder.UnsafeRelaxedJsonEscaping
    };

    private TesterSettings Settings { get; set; } = new();
