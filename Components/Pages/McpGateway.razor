@page "/mcp-service"
@page "/independent-pages/mcp"
@implements IDisposable
@inject McpGatewayService Gateway
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>Dubbo MCP 服务</PageTitle>

<div class="mcp-shell">
    <header class="mcp-header">
        <button class="mcp-back" @onclick='() => Navigation.NavigateTo("/")'>← 返回主页</button>
        <div class="mcp-brand"><span>D</span><div><h1>Dubbo MCP 服务</h1><p>全局后台服务 · Streamable HTTP</p></div></div>
        <div class="mcp-state @(IsGatewayEnabled ? "enabled" : null)">
            <i></i>
            <strong>@(IsGatewayEnabled ? "服务已启用" : "服务未启用")</strong>
            <span>@EnabledMethodCount 个工具</span>
        </div>
    </header>

    <main class="mcp-content">
        <section class="mcp-card settings-card">
            <div class="mcp-card-heading settings-heading expandable-heading" @onclick="ToggleGlobalSettings">
                <button type="button" class="settings-collapse-button" aria-expanded="@GlobalSettingsExpanded" @onclick="ToggleGlobalSettings" @onclick:stopPropagation="true">
                    <span class="settings-chevron">@(GlobalSettingsExpanded ? "▾" : "›")</span>
                    <span><strong>全局配置</strong></span>
                </button>
                <div class="settings-summary">
                    <span class="endpoint-summary" title="@Endpoint"><b>MCP：</b><code>@Endpoint</code><button type="button" title="复制 MCP 地址" @onclick="() => CopyAsync(Endpoint)" @onclick:stopPropagation="true">复制</button></span>
                    <span>ZooKeeper：@(string.IsNullOrWhiteSpace(Config.ZooKeeperAddress) ? "未配置" : Config.ZooKeeperAddress)</span>
                    <span>鉴权：@(Config.AuthenticationEnabled ? "Bearer Token" : "关闭")</span>
                    <span>记录上限：@Config.HistoryLimit</span>
                    @if (NoticeIsError || NoticeIsWarning)
                    {
                        <span class="@(NoticeIsError ? "settings-error" : "settings-warning")"
                              role="@(NoticeIsError ? "alert" : "status")"
                              title="@Notice">@Notice</span>
                    }
                </div>
                <div class="settings-heading-actions" @onclick:stopPropagation="true">
                    <label class="mcp-switch" title="全局开关开启时配置会锁定；关闭开关后即可修改，修改后自动保存。"><input type="checkbox" disabled="@IsSaving" @bind="Config.Enabled" @bind:after="AutoSaveConfigurationAsync" /><span></span>全局开关</label>
                </div>
            </div>
            @if (GlobalSettingsExpanded)
            {
                <div class="mcp-settings-grid @(Config.Enabled ? "settings-locked" : null)">
                    <label><span class="field-label">ZooKeeper 地址 <b>*</b></span><input disabled="@(Config.Enabled || IsSaving)" @bind="Config.ZooKeeperAddress" @bind:after="AutoSaveConfigurationAsync" placeholder="例如：127.0.0.1:2181 或 zk1:2181,zk2:2181" /></label>
                    <label>注册目录<input disabled="@(Config.Enabled || IsSaving)" @bind="Config.RegistryRootPath" @bind:after="AutoSaveConfigurationAsync" placeholder="/dubbo" /></label>
                    <label>元数据中心地址<input disabled="@(Config.Enabled || IsSaving)" @bind="Config.MetadataCenterAddress" @bind:after="AutoSaveConfigurationAsync" placeholder="可选；默认复用 ZooKeeper" /></label>
                    <label>元数据目录<input disabled="@(Config.Enabled || IsSaving)" @bind="Config.MetadataRootPath" @bind:after="AutoSaveConfigurationAsync" placeholder="可选；自动推导" /></label>
                    <label>调用超时（ms）<input disabled="@(Config.Enabled || IsSaving)" type="number" min="100" max="600000" @bind="Config.RequestTimeoutMs" @bind:after="AutoSaveConfigurationAsync" /></label>
                    <label>内存记录上限<input disabled="@(Config.Enabled || IsSaving)" type="number" min="10" max="2000" @bind="Config.HistoryLimit" @bind:after="AutoSaveConfigurationAsync" /></label>
                    <label class="span-two">MCP Endpoint
                        <div class="copy-field"><input readonly value="@Endpoint" /><button @onclick="() => CopyAsync(Endpoint)">复制</button></div>
                    </label>
                    <div class="auth-setting span-two">
                        <label class="mcp-switch"><input type="checkbox" disabled="@(Config.Enabled || IsSaving)" @bind="Config.AuthenticationEnabled" @bind:after="AutoSaveConfigurationAsync" /><span></span>启用鉴权</label>
                        <small>@(Config.AuthenticationEnabled ? "启用后，远程 Agent 必须携带 Bearer 访问令牌。" : "鉴权已关闭，任何能访问 MCP Endpoint 的客户端都可以直接调用已启用工具。")</small>
                    </div>
                    @if (Config.AuthenticationEnabled)
                    {
                        <label class="span-two">Bearer 访问令牌
                            <div class="copy-field"><input type="@(ShowToken ? "text" : "password")" readonly value="@Config.AccessToken" /><button @onclick="() => ShowToken = !ShowToken">@(ShowToken ? "隐藏" : "显示")</button><button @onclick="() => CopyAsync(Config.AccessToken)">复制</button><button disabled="@(Config.Enabled || IsSaving)" class="danger-link" @onclick="RegenerateTokenAsync">重新生成</button></div>
                            <small>远程 Agent 连接时设置请求头：Authorization: Bearer &lt;令牌&gt;</small>
                        </label>
                    }
                </div>
            }
        </section>

        <section class="mcp-card service-list-card @(ShowRefreshSettings ? "settings-popover-open" : null)">
            <div class="mcp-card-heading settings-heading service-list-heading expandable-heading" @onclick="ToggleServiceList">
                <button type="button" class="settings-collapse-button" aria-expanded="@ServiceListExpanded" @onclick="ToggleServiceList" @onclick:stopPropagation="true">
                    <span class="settings-chevron">@(ServiceListExpanded ? "▾" : "›")</span>
                    <span><strong>服务与方法列表</strong></span>
                </button>
                <div class="settings-summary service-list-summary">
                    <span>@RegistryRootCount 个注册目录</span>
                    <span>@Services.Count 个服务</span>
                    <span>@Config.Methods.Count 个配置</span>
                </div>
                <div class="settings-heading-actions" @onclick:stopPropagation="true">
                    <button class="link-button" disabled="@IsBusy" @onclick="RefreshListAsync">@(IsScanning ? "刷新中…" : "刷新列表")</button>
                    <div class="refresh-settings">
                        <button type="button" class="refresh-settings-button" title="刷新设置" aria-expanded="@ShowRefreshSettings" @onclick="() => ShowRefreshSettings = !ShowRefreshSettings">⚙</button>
                        @if (ShowRefreshSettings)
                        {
                            <div class="refresh-settings-popover">
                                <label><input type="checkbox" @bind="Config.OnlyRefreshServiceNames" @bind:after="AutoSaveConfigurationAsync" />仅刷新服务名称</label>
                                <small>关闭时同时刷新 Provider 与方法信息</small>
                            </div>
                        }
                    </div>
                </div>
            </div>
            @if (ServiceListExpanded)
            {
                <div class="service-config-workspace">
                    <div class="catalog-pane">
                        <div class="mcp-search"><span>⌕</span><input @bind="SearchText" @bind:event="oninput" placeholder="搜索服务或方法…" /></div>
                        <div class="mcp-catalog-list">
                            @if (Services.Count == 0)
                            {
                                <div class="mcp-empty">暂无服务，请确认 ZooKeeper 配置后刷新列表</div>
                            }
                            else
                            {
                                @foreach (IGrouping<string, DubboServiceItem> rootGroup in FilteredServiceGroups)
                                {
                                    string root = rootGroup.Key;
                                    bool rootExpanded = ExpandedRegistryRoots.Contains(root);
                                    <div class="mcp-registry-root" @key="root">
                                        <button class="mcp-root-row" @onclick="() => ToggleRegistryRoot(root)">
                                            <span>@(rootExpanded ? "▾" : "›")</span>
                                            <code title="@root">@root</code>
                                            <small>@rootGroup.Count() 个服务</small>
                                        </button>
                                        @if (rootExpanded)
                                        {
                                            <div class="mcp-root-services">
                                                @foreach (DubboServiceItem service in rootGroup)
                                                {
                                                    <div class="mcp-service" @key="service">
                                                        <button class="mcp-service-row" @onclick="() => ToggleServiceAsync(service)">
                                                            <span>@(IsServiceExpanded(service) ? "▾" : "›")</span>
                                                            <b title="@service.Name">@service.Name</b>
                                                            @if (service.IsLoaded)
                                                            {
                                                                <small>@service.Methods.Count</small>
                                                            }
                                                        </button>
                                                        @if (IsServiceExpanded(service))
                                                        {
                                                            <div class="mcp-methods">
                                                                @if (IsServiceLoading(service))
                                                                {
                                                                    <div class="mcp-loading">加载方法…</div>
                                                                }
                                                                else
                                                                {
                                                                    @foreach (string method in service.Methods)
                                                                    {
                                                                        IReadOnlyList<McpDubboMethodConfiguration> methodConfigurations = MethodConfigurations(service, method);
                                                                        <div class="mcp-method-group" @key="method">
                                                                            <div class="mcp-method-row">
                                                                                <span>↪</span>
                                                                                <b title="@method">@method</b>
                                                                                <span class="method-state">@(methodConfigurations.Count == 0 ? "尚未配置 MCP" : $"{methodConfigurations.Count} 个 MCP 配置")</span>
                                                                                <button class="link-button" @onclick="() => OpenAddDialogAsync(service, method)">添加 MCP</button>
                                                                            </div>
                                                                            @foreach (McpDubboMethodConfiguration configuredMethod in methodConfigurations)
                                                                            {
                                                                                <div class="method-config-inline" @key="configuredMethod.Id">
                                                                                    <code title="@configuredMethod.Signature">@configuredMethod.ToolName</code>
                                                                                    <span title="@configuredMethod.Description">@configuredMethod.Description</span>
                                                                                    <em class="@(configuredMethod.Enabled ? "enabled" : null)">@(configuredMethod.Enabled ? "已启用" : "未启用")</em>
                                                                                    <span class="method-config-actions">
                                                                                        <button class="link-button" @onclick="() => OpenDetailsDialog(configuredMethod)">查看配置</button>
                                                                                        <button class="link-button" @onclick="() => OpenEditDialogAsync(configuredMethod)">编辑配置</button>
                                                                                        <button class="link-button danger" @onclick="() => DeleteConfiguredMethodAsync(configuredMethod)">删除</button>
                                                                                    </span>
                                                                                </div>
                                                                            }
                                                                        </div>
                                                                    }
                                                                    @if (service.Methods.Count == 0)
                                                                    {
                                                                        <div class="mcp-empty small">没有可用方法</div>
                                                                    }
                                                                }
                                                            </div>
                                                        }
                                                    </div>
                                                }
                                            </div>
                                        }
                                    </div>
                                }
                            }
                        </div>
                    </div>
                </div>
            }
        </section>

        <section class="mcp-card enabled-card">
            <div class="mcp-card-heading compact"><div><h2>已配置工具</h2><p>每个签名对应一个独立 MCP 工具</p></div><div class="configured-heading-actions"><strong>@Config.Methods.Count 个配置</strong><button class="primary small-button" @onclick="OpenAddDialog">＋ 添加配置</button></div></div>
            <div class="configured-list">
                @if (Config.Methods.Count == 0)
                {
                    <div class="mcp-empty small">暂未配置方法</div>
                }
                else
                {
                    <div class="configured-row configured-table-head"><span>工具名</span><span>注册目录</span><span>服务 / 方法</span><span>方法描述</span><span>启用</span><span>操作</span></div>
                    @foreach (McpDubboMethodConfiguration method in Config.Methods.OrderBy(item => item.ToolName, StringComparer.Ordinal))
                    {
                        <div class="configured-row" @key="method.Id">
                            <b title="@method.ToolName">@method.ToolName</b>
                            <code title="@method.RegistryRootPath">@method.RegistryRootPath</code>
                            <span class="configured-method" title="@method.Signature"><b>@method.ServiceName</b><small>#@method.MethodName</small></span>
                            <span class="configured-description" title="@method.Description">@(string.IsNullOrWhiteSpace(method.Description) ? "—" : method.Description)</span>
                            <label class="mcp-switch compact-switch"><input type="checkbox" checked="@method.Enabled" @onchange="() => ToggleConfiguredMethodAsync(method)" /><span></span>@(method.Enabled ? "已启用" : "未启用")</label>
                            <span class="configured-actions"><button class="link-button" @onclick="() => OpenDetailsDialog(method)">详情</button><button class="link-button" @onclick="() => OpenEditDialogAsync(method)">编辑</button><button class="link-button danger" @onclick="() => DeleteConfiguredMethodAsync(method)">删除</button></span>
                        </div>
                    }
                }
            </div>
        </section>

        <section class="mcp-card history-card-mcp">
            <div class="mcp-card-heading compact"><div><h2>MCP 调用记录</h2><p>仅保存在内存，最多保留 @Config.HistoryLimit 条</p></div><button class="link-button danger" disabled="@(History.Count == 0)" @onclick="Gateway.ClearHistory">清空</button></div>
            <div class="mcp-history">
                @if (History.Count == 0)
                {
                    <div class="mcp-empty small">暂无 MCP 调用</div>
                }
                else
                {
                    @foreach (McpCallRecord record in History)
                    {
                        <details class="mcp-record @(record.Success ? "success" : "failed")">
                            <summary>
                                <span>@record.StartedAt.ToLocalTime().ToString("MM-dd HH:mm:ss")</span>
                                <b>@record.ToolName</b>
                                <span class="mcp-record-target" title="@FormatRecordTarget(record)">
                                    <code>@DisplayRegistryRoot(record.RegistryRootPath)</code>
                                    <span>@record.ServiceName#@record.MethodName</span>
                                </span>
                                <em>@(record.Success ? "成功" : "失败")</em>
                                <span>@record.ElapsedMs ms</span>
                                <span title="调用方地址">@DisplayRemoteAddress(record.RemoteAddress)</span>
                            </summary>
                            <div><h3>请求参数</h3><pre>@record.RequestJson</pre><h3>响应 / 错误</h3><pre>@record.Response</pre></div>
                        </details>
                    }
                }
            </div>
        </section>
    </main>
</div>

@if (DialogMode != MethodDialogMode.None)
{
    <div class="mcp-modal-backdrop" role="presentation" @onclick="CloseMethodDialog">
        <section class="mcp-modal" role="dialog" aria-modal="true" aria-labelledby="method-dialog-title" @onclick:stopPropagation="true">
            <header>
                <div>
                    <h2 id="method-dialog-title">@DialogTitle</h2>
                    <p>@(DialogMode == MethodDialogMode.Details ? "查看 MCP 工具的完整配置信息" : "选择 Dubbo 方法并维护 MCP 工具说明")</p>
                </div>
                <button type="button" title="关闭" @onclick="CloseMethodDialog">×</button>
            </header>

            @if (DialogMode == MethodDialogMode.Details && DialogEditor is not null)
            {
                <div class="method-details">
                    <dl>
                        <dt>MCP 工具名</dt><dd><code>@DialogEditor.ToolName</code></dd>
                        <dt>注册目录</dt><dd><code>@DialogEditor.RegistryRootPath</code></dd>
                        <dt>服务方法</dt><dd>@DialogEditor.ServiceName#@DialogEditor.MethodName</dd>
                        <dt>Java 签名</dt><dd><code>@DialogEditor.Signature</code></dd>
                        <dt>状态</dt><dd>@(DialogEditor.Enabled ? "已启用" : "未启用")</dd>
                        <dt>方法描述</dt><dd>@DialogEditor.Description</dd>
                        <dt>适用/触发条件</dt><dd>@DialogEditor.TriggerCondition</dd>
                        <dt>参数要求</dt><dd>@DialogEditor.ParameterGuidance</dd>
                        <dt>请求示例</dt><dd><pre>@DialogEditor.ExampleRequestJson</pre></dd>
                    </dl>
                </div>
                <footer><button class="secondary" @onclick="CloseMethodDialog">关闭</button><button class="primary" @onclick="() => OpenEditDialogAsync(DialogEditor)">编辑</button></footer>
            }
            else
            {
                <div class="method-dialog-body">
                    @if (DialogMode == MethodDialogMode.Add)
                    {
                        <div class="dialog-source-selectors">
                            <label><span class="field-label">注册目录 <b>*</b></span>
                                <select value="@DialogRegistryRoot" @onchange="DialogRegistryRootChanged">
                                    <option value="">请选择注册目录</option>
                                    @foreach (string root in RegistryRoots)
                                    {
                                        <option value="@root">@root</option>
                                    }
                                </select>
                            </label>
                            <label><span class="field-label">服务 <b>*</b></span>
                                <select value="@DialogServiceName" disabled="@(string.IsNullOrWhiteSpace(DialogRegistryRoot) || IsDialogBusy)" @onchange="DialogServiceChangedAsync">
                                    <option value="">请选择服务</option>
                                    @foreach (DubboServiceItem service in DialogServices)
                                    {
                                        <option value="@service.Name">@service.Name</option>
                                    }
                                </select>
                            </label>
                            <label><span class="field-label">方法 <b>*</b></span>
                                <select value="@DialogMethodName" disabled="@(DialogSelectedService is null || IsDialogBusy)" @onchange="DialogMethodChangedAsync">
                                    <option value="">请选择方法</option>
                                    @foreach (string method in DialogSelectedService?.Methods ?? [])
                                    {
                                        <option value="@method">@method</option>
                                    }
                                </select>
                            </label>
                        </div>
                    }

                    @if (IsDialogBusy)
                    {
                        <div class="mcp-empty dialog-empty">正在读取服务方法与签名…</div>
                    }
                    else if (DialogEditor is null)
                    {
                        <div class="mcp-empty dialog-empty">@(Services.Count == 0 ? "请先扫描服务，再添加方法配置。" : "请选择注册目录、服务和方法。")</div>
                    }
                    else
                    {
                        <div class="method-editor dialog-editor">
                            @if (DialogMode == MethodDialogMode.Edit)
                            {
                                <div class="dialog-source-readonly" aria-label="当前 Dubbo 方法">
                                    <label>注册目录
                                        <input value="@DialogEditor.RegistryRootPath" readonly />
                                    </label>
                                    <label>服务
                                        <input value="@DialogEditor.ServiceName" readonly />
                                    </label>
                                    <label>方法
                                        <input value="@DialogEditor.MethodName" readonly />
                                    </label>
                                </div>
                            }
                            @if (DialogRequiresManualSignature)
                            {
                                <div class="manual-signature-warning" role="status">
                                    <strong>未读取到方法签名</strong>
                                    <span>服务可能未注册元数据，或元数据中心当前不可用。请手动填写准确的 Java 参数类型后继续配置。</span>
                                </div>
                                <div class="manual-signature-input">
                                    <label><span class="field-label">Java 参数类型 <b>*</b></span>
                                        <input value="@DialogJavaParameterTypes"
                                               disabled="@DialogManualNoParameters"
                                               @oninput="DialogJavaParameterTypesChanged"
                                               placeholder="例如：java.lang.String, java.lang.Integer" />
                                    </label>
                                    <label class="manual-no-parameters">
                                        <input type="checkbox" checked="@DialogManualNoParameters" @onchange="DialogManualNoParametersChanged" />
                                        <span>无参数方法</span>
                                    </label>
                                    <small>多个参数使用英文逗号分隔；支持填写泛型，保存时会自动转换为 Dubbo 调用需要的类型。</small>
                                </div>
                            }
                            @if (DialogSignatures.Count > 1)
                            {
                                <label>方法重载
                                    <select value="@DialogSignatureIndex" @onchange="DialogSignatureChanged">
                                        @for (int index = 0; index < DialogSignatures.Count; index++)
                                        {
                                            <option value="@index">重载 @(index + 1)：@DialogSignatures[index].Signature</option>
                                        }
                                    </select>
                                </label>
                            }
                            <div class="signature-view"><span>Java 签名</span><code>@DialogEditor.Signature</code></div>
                            <label><span class="field-label">MCP 工具名 <b>*</b></span><input @bind="DialogEditor.ToolName" /></label>
                            <label><span class="field-label">方法描述 <b>*</b></span><textarea @bind="DialogEditor.Description" placeholder="这个工具会完成什么操作、返回什么结果"></textarea></label>
                            <label><span class="field-label">适用/触发条件 <b>*</b></span><textarea @bind="DialogEditor.TriggerCondition" placeholder="用户提出什么需求时 Agent 应调用这个工具"></textarea></label>
                            <label><span class="field-label">参数要求 <b>*</b></span><textarea @bind="DialogEditor.ParameterGuidance" placeholder="arguments 数组中每个位置的含义、格式、范围和示例"></textarea></label>
                            <div class="request-example-block">
                                <span>请求示例</span>
                                <pre>@DialogEditor.ExampleRequestJson</pre>
                                <div class="request-example-actions"><button type="button" class="link-button" @onclick="OpenDebugDialog">调试该方法</button></div>
                            </div>
                        </div>
                    }
                </div>
                <footer>
                    @if (DialogEditor is not null)
                    {
                        <label class="mcp-switch dialog-enabled"><input type="checkbox" @bind="DialogEditor.Enabled" /><span></span><em>启用该方法</em></label>
                    }
                    <button class="secondary" @onclick="CloseMethodDialog">取消</button>
                    <button class="primary" disabled="@(DialogEditor is null || IsSaving || IsDialogBusy || (DialogRequiresManualSignature && !DialogManualNoParameters && string.IsNullOrWhiteSpace(DialogJavaParameterTypes)))" @onclick="SaveDialogConfigurationAsync">保存配置</button>
                </footer>
            }
        </section>
    </div>
}

@if (DebugMethod is not null)
{
    <div class="mcp-modal-backdrop debug-modal-backdrop" role="presentation" @onclick="CloseDebugDialog">
        <section class="mcp-modal debug-modal" role="dialog" aria-modal="true" aria-labelledby="debug-dialog-title" @onclick:stopPropagation="true">
            <header>
                <div>
                    <h2 id="debug-dialog-title">调试 Dubbo 方法</h2>
                    <p>请求只会发送到当前 MCP 配置绑定的 Dubbo 方法</p>
                </div>
                <button type="button" title="关闭" @onclick="CloseDebugDialog">×</button>
            </header>
            <div class="debug-dialog-body">
                <div class="debug-target" aria-label="调试目标">
                    <div><span>注册目录</span><code>@DebugMethod.RegistryRootPath</code></div>
                    <div><span>服务方法</span><code>@DebugMethod.ServiceName#@DebugMethod.MethodName</code></div>
                </div>

                @if (DebugCanEditJavaParameterTypes)
                {
                    <label>
                        <span class="field-label">Java 参数类型 <b>*</b></span>
                        <input @bind="DebugJavaParameterTypes" placeholder="例如：java.lang.String, java.lang.Integer" />
                        <small>该方法未成功读取元数据，可在本次调试中修改参数类型；不会改动 MCP 配置。</small>
                    </label>
                }
                else
                {
                    <div class="signature-view"><span>Java 签名</span><code>@DebugMethod.Signature</code></div>
                }

                <label class="debug-request-input">
                    <span>请求内容</span>
                    <textarea @bind="DebugRequestJson" spellcheck="false"></textarea>
                </label>

                @if (DebugOutput is not null)
                {
                    <section class="debug-result @(DebugOutput.Success ? "success" : "failed")">
                        <div><strong>@(DebugOutput.Success ? "调用成功" : "调用失败")</strong><span>@DebugOutput.RequestElapsed ms</span></div>
                        <pre>@(DebugOutput.Success ? DebugOutput.Content : DebugOutput.Error)</pre>
                    </section>
                }
                else if (!string.IsNullOrWhiteSpace(DebugFailure))
                {
                    <section class="debug-result failed">
                        <div><strong>调用失败</strong></div>
                        <pre>@DebugFailure</pre>
                    </section>
                }
            </div>
            <footer>
                <button class="secondary" @onclick="CloseDebugDialog">关闭</button>
                <button class="primary" disabled="@IsDebugging" @onclick="SendDebugRequestAsync">@(IsDebugging ? "发送中…" : "发送请求")</button>
            </footer>
        </section>
    </div>
}

@code {
    private McpGatewayConfiguration Config { get; set; } = new();
    private List<DubboServiceItem> Services { get; set; } = [];
    private HashSet<string> ExpandedRegistryRoots { get; } = new(StringComparer.Ordinal);
    private HashSet<string> ExpandedServiceKeys { get; } = new(StringComparer.Ordinal);
    private HashSet<string> LoadingServiceKeys { get; } = new(StringComparer.Ordinal);
    private IReadOnlyList<McpCallRecord> History { get; set; } = [];
    private string SearchText { get; set; } = string.Empty;
    private string Notice { get; set; } = "配置 ZooKeeper 并扫描服务，然后为需要暴露的方法启用 MCP。";
    private bool NoticeIsError { get; set; }
    private bool NoticeIsWarning { get; set; }
    private bool IsScanning { get; set; }
    private bool IsSaving { get; set; }
    private bool ShowToken { get; set; }
    private bool ShowRefreshSettings { get; set; }
    private bool GlobalSettingsExpanded { get; set; }
    private bool ServiceListExpanded { get; set; }
    private bool IsDialogBusy { get; set; }
    private MethodDialogMode DialogMode { get; set; }
    private McpDubboMethodConfiguration? DialogEditor { get; set; }
    private IReadOnlyList<MethodSignatureItem> DialogSignatures { get; set; } = [];
    private IReadOnlyList<MethodParameterStructure> DialogEditorParameters { get; set; } = [];
    private bool DialogRequiresManualSignature { get; set; }
    private bool DialogMetadataUnavailable { get; set; }
    private bool DialogManualNoParameters { get; set; }
    private string DialogJavaParameterTypes { get; set; } = string.Empty;
    private string DialogGeneratedToolName { get; set; } = string.Empty;
    private int DialogSignatureIndex { get; set; }
    private string DialogRegistryRoot { get; set; } = string.Empty;
    private string DialogServiceName { get; set; } = string.Empty;
    private string DialogMethodName { get; set; } = string.Empty;
    private DubboServiceItem? DialogSelectedService { get; set; }
    private McpDubboMethodConfiguration? DebugMethod { get; set; }
    private string DebugRequestJson { get; set; } = "[]";
    private string DebugJavaParameterTypes { get; set; } = string.Empty;
    private bool DebugCanEditJavaParameterTypes { get; set; }
    private bool IsDebugging { get; set; }
    private InvocationOutput? DebugOutput { get; set; }
    private string DebugFailure { get; set; } = string.Empty;

    private bool IsBusy => IsScanning || LoadingServiceKeys.Count > 0 || IsSaving || IsDialogBusy;
    private bool IsGatewayEnabled => Gateway.IsEnabled;
    private string Endpoint => Navigation.ToAbsoluteUri("mcp").ToString();
    private int EnabledMethodCount => Config.Methods.Count(method => method.Enabled);
    private int RegistryRootCount => Services.Select(service => NormalizeRegistryRoot(service.RegistryRootPath)).Distinct(StringComparer.Ordinal).Count();
    private IEnumerable<DubboServiceItem> FilteredServices => string.IsNullOrWhiteSpace(SearchText)
        ? Services
        : Services.Where(service => service.Name.Contains(SearchText, StringComparison.OrdinalIgnoreCase)
            || service.Methods.Any(method => method.Contains(SearchText, StringComparison.OrdinalIgnoreCase)));
    private IEnumerable<IGrouping<string, DubboServiceItem>> FilteredServiceGroups => FilteredServices
        .GroupBy(service => NormalizeRegistryRoot(service.RegistryRootPath), StringComparer.Ordinal)
        .OrderBy(group => group.Key, StringComparer.Ordinal);
    private IReadOnlyList<string> RegistryRoots => Services
        .Select(service => NormalizeRegistryRoot(service.RegistryRootPath))
        .Distinct(StringComparer.Ordinal)
        .Order(StringComparer.Ordinal)
        .ToArray();
    private IEnumerable<DubboServiceItem> DialogServices => Services
        .Where(service => NormalizeRegistryRoot(service.RegistryRootPath) == DialogRegistryRoot)
        .OrderBy(service => service.Name, StringComparer.Ordinal);
    private string DialogTitle => DialogMode switch
    {
        MethodDialogMode.Add => "添加 MCP 工具配置",
        MethodDialogMode.Edit => "编辑 MCP 工具配置",
        MethodDialogMode.Details => "MCP 工具配置详情",
        _ => string.Empty
    };

    private void ToggleGlobalSettings() =>
        GlobalSettingsExpanded = !GlobalSettingsExpanded;

    private void ToggleServiceList()
    {
        ServiceListExpanded = !ServiceListExpanded;
        if (!ServiceListExpanded) ShowRefreshSettings = false;
    }

    protected override async Task OnInitializedAsync()
    {
        Config = Gateway.GetConfiguration();
        History = Gateway.GetHistory();
        Gateway.Changed += GatewayChanged;
        if (!string.IsNullOrWhiteSpace(Config.ZooKeeperAddress))
        {
            await LoadServiceListAsync(forceRefresh: false, refreshDetails: false);
        }
    }

    private async void GatewayChanged()
    {
        try
        {
            await InvokeAsync(() =>
            {
                Config = Gateway.GetConfiguration();
                History = Gateway.GetHistory();
                StateHasChanged();
            });
        }
        catch (ObjectDisposedException)
        {
            // The page was disposed while a background MCP call completed.
        }
    }

    private async Task AutoSaveConfigurationAsync()
    {
        bool isEnablingGateway = Config.Enabled && !Gateway.IsEnabled;
        IsSaving = true;
        SetNotice(isEnablingGateway ? "正在检测 ZooKeeper 连接…" : "正在自动保存配置…", false);
        try
        {
            if (isEnablingGateway)
            {
                await DubboSession.TestZooKeeperAsync(Config.ZooKeeperAddress);
            }

            await Gateway.SaveConfigurationAsync(Config);
            Config = Gateway.GetConfiguration();
            SetNotice(Config.Enabled ? "配置已自动保存，MCP 服务已启用。" : "配置已自动保存，MCP 服务当前关闭。", false);
        }
        catch (Exception exception)
        {
            // 自动保存失败时必须恢复到后台真实状态，避免页面再次显示尚未生效的开关值。
            Config = Gateway.GetConfiguration();
            SetNotice(
                isEnablingGateway
                    ? $"无法启用 MCP：{exception.Message}"
                    : $"自动保存失败：{exception.Message}",
                true);
        }
        finally
        {
            IsSaving = false;
        }
    }

    private Task RefreshListAsync() =>
        LoadServiceListAsync(forceRefresh: true, refreshDetails: !Config.OnlyRefreshServiceNames);

    private async Task LoadServiceListAsync(bool forceRefresh, bool refreshDetails)
    {
        if (string.IsNullOrWhiteSpace(Config.ZooKeeperAddress))
        {
            SetNotice("请先填写 ZooKeeper 地址。", true);
            return;
        }

        IsScanning = true;
        try
        {
            DubboCatalogLoadResult result = await Gateway.LoadServicesAsync(
                Config.ToTesterSettings(),
                forceRefresh);
            Services = result.Services.ToList();
            ExpandedServiceKeys.Clear();
            LoadingServiceKeys.Clear();
            ExpandedRegistryRoots.Clear();
            foreach (string root in result.RegistryRoots)
            {
                ExpandedRegistryRoots.Add(NormalizeRegistryRoot(root));
            }

            int detailFailureCount = 0;
            if (refreshDetails && Services.Count > 0)
            {
                await Parallel.ForEachAsync(
                    Services,
                    new ParallelOptions { MaxDegreeOfParallelism = 6 },
                    async (service, cancellationToken) =>
                    {
                        try
                        {
                            await Gateway.LoadServiceDetailsAsync(
                                Config.ToTesterSettings(),
                                service,
                                forceRefresh: true,
                                cancellationToken);
                        }
                        catch
                        {
                            Interlocked.Increment(ref detailFailureCount);
                        }
                    });
            }

            SetNotice(
                detailFailureCount == 0
                    ? $"已加载 {Services.Count} 个 Dubbo 服务。"
                    : $"已加载 {Services.Count} 个服务，其中 {detailFailureCount} 个服务的方法刷新失败。",
                detailFailureCount > 0);
        }
        catch (Exception exception)
        {
            SetNotice($"加载服务列表失败：{exception.Message}", true);
        }
        finally
        {
            IsScanning = false;
        }
    }

    private async Task ToggleServiceAsync(DubboServiceItem service)
    {
        string serviceKey = ServiceExpansionKey(service);
        if (!ExpandedServiceKeys.Add(serviceKey))
        {
            ExpandedServiceKeys.Remove(serviceKey);
            return;
        }

        if (!LoadingServiceKeys.Add(serviceKey)) return;
        try
        {
            // Expanding a service is an explicit refresh point. This avoids presenting
            // an older cached zero-method snapshot and also updates the shared catalog
            // cache with the latest providers/methods returned by ZooKeeper.
            await Gateway.LoadServiceDetailsAsync(
                Config.ToTesterSettings(),
                service,
                forceRefresh: true);
        }
        catch (Exception exception)
        {
            SetNotice($"读取服务方法失败：{exception.Message}", true);
        }
        finally
        {
            LoadingServiceKeys.Remove(serviceKey);
        }
    }

    private bool IsServiceExpanded(DubboServiceItem service) =>
        ExpandedServiceKeys.Contains(ServiceExpansionKey(service));

    private bool IsServiceLoading(DubboServiceItem service) =>
        LoadingServiceKeys.Contains(ServiceExpansionKey(service));

    private static string ServiceExpansionKey(DubboServiceItem service) =>
        $"{RegistryRootPaths.NormalizeRoot(service.RegistryRootPath)}\n{service.Name}";

    private void ToggleRegistryRoot(string root)
    {
        if (!ExpandedRegistryRoots.Add(root))
        {
            ExpandedRegistryRoots.Remove(root);
        }
    }

    private async Task ToggleConfiguredMethodAsync(McpDubboMethodConfiguration method)
    {
        if (!method.Enabled && (string.IsNullOrWhiteSpace(method.Description)
            || string.IsNullOrWhiteSpace(method.TriggerCondition)
            || string.IsNullOrWhiteSpace(method.ParameterGuidance)))
        {
            await OpenEditDialogAsync(method);
            SetNotice("启用方法前，请先填写方法描述、触发条件和参数要求。", true);
            return;
        }

        bool previous = method.Enabled;
        method.Enabled = !method.Enabled;
        try
        {
            await Gateway.SaveConfigurationAsync(Config);
            Config = Gateway.GetConfiguration();
            SetNotice(method.Enabled ? $"已启用 {method.ToolName}。" : $"已停用 {method.ToolName}。", false);
        }
        catch (Exception exception)
        {
            method.Enabled = previous;
            SetNotice(exception.Message, true);
        }
    }

    private void OpenAddDialog()
    {
        DialogMode = MethodDialogMode.Add;
        DialogEditor = null;
        DialogEditorParameters = [];
        DialogSignatures = [];
        ResetManualSignatureState();
        DialogSignatureIndex = 0;
        DialogRegistryRoot = RegistryRoots.FirstOrDefault() ?? string.Empty;
        DialogServiceName = string.Empty;
        DialogMethodName = string.Empty;
        DialogSelectedService = null;
    }

    private async Task OpenAddDialogAsync(DubboServiceItem service, string methodName)
    {
        OpenAddDialog();
        DialogRegistryRoot = NormalizeRegistryRoot(service.RegistryRootPath);
        DialogServiceName = service.Name;
        DialogMethodName = methodName;
        DialogSelectedService = service;
        await LoadDialogMethodAsync();
    }

    private void OpenDetailsDialog(McpDubboMethodConfiguration method)
    {
        DialogMode = MethodDialogMode.Details;
        DialogEditor = method.Clone();
        DialogEditorParameters = [];
        DialogSignatures = [];
        ResetManualSignatureState();
        DialogRegistryRoot = method.RegistryRootPath;
        DialogServiceName = method.ServiceName;
        DialogMethodName = method.MethodName;
        DialogSelectedService = null;
    }

    private async Task OpenEditDialogAsync(McpDubboMethodConfiguration method)
    {
        DialogMode = MethodDialogMode.Edit;
        DialogEditor = method.Clone();
        DialogEditorParameters = [];
        DialogSignatures = [];
        ResetManualSignatureState();
        DialogRegistryRoot = NormalizeRegistryRoot(method.RegistryRootPath);
        DialogServiceName = method.ServiceName;
        DialogMethodName = method.MethodName;
        DialogSelectedService = Services.FirstOrDefault(service =>
            NormalizeRegistryRoot(service.RegistryRootPath) == DialogRegistryRoot
            && service.Name == method.ServiceName);

        IsDialogBusy = true;
        try
        {
            IReadOnlyList<MethodSignatureItem> signatures = await Gateway.LoadMethodSignaturesAsync(
                Config.ToTesterSettings(),
                method.ServiceName,
                method.MethodName,
                method.RegistryRootPath);
            DialogSignatures = signatures;
            MethodSignatureItem? signature = signatures.FirstOrDefault(candidate =>
                McpDubboMethodConfiguration.BuildConfigurationKey(
                    method.RegistryRootPath,
                    candidate.ServiceName,
                    candidate.MethodName,
                    candidate.ParameterTypes,
                    candidate.Version,
                    candidate.Group) == method.ConfigurationKey);
            if (signature is not null)
            {
                DialogEditorParameters = DubboTypeStructureBuilder.Build(signature);
                DialogMetadataUnavailable = false;
            }
            else
            {
                DialogMetadataUnavailable = true;
                DialogEditor.ParameterTypesManuallyConfigured = true;
                SetWarning("未能从元数据中心匹配已保存的方法签名，调试时可手动修改 Java 参数类型。");
            }
        }
        catch (Exception)
        {
            DialogMetadataUnavailable = true;
            DialogEditor.ParameterTypesManuallyConfigured = true;
            SetWarning("未能从元数据中心读取方法结构，将继续使用已保存的 Java 参数类型。");
        }
        finally
        {
            IsDialogBusy = false;
        }
    }

    private void DialogRegistryRootChanged(ChangeEventArgs eventArgs)
    {
        DialogRegistryRoot = eventArgs.Value?.ToString() ?? string.Empty;
        DialogServiceName = string.Empty;
        DialogMethodName = string.Empty;
        DialogSelectedService = null;
        DialogEditor = null;
        DialogEditorParameters = [];
        DialogSignatures = [];
        ResetManualSignatureState();
    }

    private async Task DialogServiceChangedAsync(ChangeEventArgs eventArgs)
    {
        DialogServiceName = eventArgs.Value?.ToString() ?? string.Empty;
        DialogMethodName = string.Empty;
        DialogEditor = null;
        DialogEditorParameters = [];
        DialogSignatures = [];
        ResetManualSignatureState();
        DialogSelectedService = DialogServices.FirstOrDefault(service => service.Name == DialogServiceName);
        if (DialogSelectedService is null) return;

        // The catalog already keeps loaded method names in its shared cache. Reusing
        // them here avoids an unnecessary asynchronous refresh and prevents the
        // selector dialog from collapsing and expanding again after every choice.
        if (DialogSelectedService.IsLoaded) return;

        IsDialogBusy = true;
        try
        {
            await Gateway.LoadServiceDetailsAsync(
                Config.ToTesterSettings(),
                DialogSelectedService,
                forceRefresh: false);
        }
        catch (Exception exception)
        {
            SetNotice($"读取服务方法失败：{exception.Message}", true);
        }
        finally
        {
            IsDialogBusy = false;
        }
    }

    private async Task DialogMethodChangedAsync(ChangeEventArgs eventArgs)
    {
        DialogMethodName = eventArgs.Value?.ToString() ?? string.Empty;
        await LoadDialogMethodAsync();
    }

    private async Task LoadDialogMethodAsync()
    {
        DialogEditor = null;
        DialogEditorParameters = [];
        DialogSignatures = [];
        ResetManualSignatureState();
        if (DialogSelectedService is null || string.IsNullOrWhiteSpace(DialogMethodName)) return;

        IsDialogBusy = true;
        try
        {
            DialogSignatures = await Gateway.LoadMethodSignaturesAsync(
                Config.ToTesterSettings(),
                DialogSelectedService.Name,
                DialogMethodName,
                DialogSelectedService.RegistryRootPath);
            if (DialogSignatures.Count == 0)
            {
                PrepareManualDialogEditor(
                    DialogSelectedService.RegistryRootPath,
                    DialogSelectedService.Name,
                    DialogMethodName);
                SetWarning(BuildManualSignatureWarning(DialogSelectedService.Name, DialogMethodName));
                return;
            }

            DialogSignatureIndex = 0;
            PrepareDialogEditor(DialogSignatures[0], DialogSelectedService.RegistryRootPath);
        }
        catch (Exception)
        {
            PrepareManualDialogEditor(
                DialogSelectedService.RegistryRootPath,
                DialogSelectedService.Name,
                DialogMethodName);
            SetWarning(BuildManualSignatureWarning(DialogSelectedService.Name, DialogMethodName));
        }
        finally
        {
            IsDialogBusy = false;
        }
    }

    private void DialogSignatureChanged(ChangeEventArgs eventArgs)
    {
        if (!int.TryParse(eventArgs.Value?.ToString(), out int index)
            || index < 0
            || index >= DialogSignatures.Count
            || DialogSelectedService is null) return;
        DialogSignatureIndex = index;
        PrepareDialogEditor(DialogSignatures[index], DialogSelectedService.RegistryRootPath);
    }

    private void PrepareDialogEditor(MethodSignatureItem signature, string registryRootPath)
    {
        ResetManualSignatureState();
        DialogEditorParameters = DubboTypeStructureBuilder.Build(signature);
        string preferredToolName = McpToolSchemaBuilder.BuildToolName(
            signature.ServiceName,
            signature.MethodName,
            signature.ParameterTypes);
        DialogGeneratedToolName = McpToolSchemaBuilder.EnsureUniqueToolName(
            preferredToolName,
            Config.Methods.Select(method => method.ToolName));
        DialogEditor = new McpDubboMethodConfiguration
        {
            ToolName = DialogGeneratedToolName,
            RegistryRootPath = registryRootPath,
            ServiceName = signature.ServiceName,
            MethodName = signature.MethodName,
            ParameterTypes = [.. signature.ParameterTypes],
            ReturnType = signature.ReturnType ?? string.Empty,
            Version = signature.Version ?? string.Empty,
            Group = signature.Group ?? string.Empty,
            ParameterTypesManuallyConfigured = false,
            ExampleRequestJson = DubboTypeStructureBuilder.GenerateExampleJson(DialogEditorParameters)
        };
    }

    private void PrepareManualDialogEditor(string registryRootPath, string serviceName, string methodName)
    {
        DialogRequiresManualSignature = true;
        DialogManualNoParameters = false;
        DialogJavaParameterTypes = string.Empty;
        DialogGeneratedToolName = string.Empty;
        DialogEditorParameters = [];
        DialogEditor = new McpDubboMethodConfiguration
        {
            RegistryRootPath = registryRootPath,
            ServiceName = serviceName,
            MethodName = methodName,
            ParameterTypes = [],
            ParameterTypesManuallyConfigured = true,
            InputSchemaJson = McpToolSchemaBuilder.BuildInputSchema([], string.Empty),
            ExampleRequestJson = "[]"
        };
        ApplyManualSignature();
    }

    private void DialogJavaParameterTypesChanged(ChangeEventArgs eventArgs)
    {
        DialogJavaParameterTypes = eventArgs.Value?.ToString() ?? string.Empty;
        ApplyManualSignature();
    }

    private void DialogManualNoParametersChanged(ChangeEventArgs eventArgs)
    {
        DialogManualNoParameters = eventArgs.Value is bool value
            ? value
            : bool.TryParse(eventArgs.Value?.ToString(), out bool parsed) && parsed;
        if (DialogManualNoParameters) DialogJavaParameterTypes = string.Empty;
        ApplyManualSignature();
    }

    private void ApplyManualSignature()
    {
        if (!DialogRequiresManualSignature || DialogEditor is null) return;

        string[] parameterTypes = DialogManualNoParameters
            ? []
            : JsonArgumentParser.ParseJavaTypes(DialogJavaParameterTypes);
        DialogEditor.ParameterTypes = parameterTypes;
        DialogEditor.ParameterTypesManuallyConfigured = true;
        var signature = new MethodSignatureItem
        {
            ServiceName = DialogEditor.ServiceName,
            MethodName = DialogEditor.MethodName,
            ParameterTypes = parameterTypes
        };
        DialogEditorParameters = DubboTypeStructureBuilder.Build(signature);
        DialogEditor.ExampleRequestJson = DubboTypeStructureBuilder.GenerateExampleJson(DialogEditorParameters);
        DialogEditor.InputSchemaJson = McpToolSchemaBuilder.BuildInputSchema(
            DialogEditorParameters,
            DialogEditor.ParameterGuidance);

        string preferredToolName = McpToolSchemaBuilder.BuildToolName(
            DialogEditor.ServiceName,
            DialogEditor.MethodName,
            parameterTypes);
        string uniqueToolName = McpToolSchemaBuilder.EnsureUniqueToolName(
            preferredToolName,
            Config.Methods.Select(method => method.ToolName));
        if (string.IsNullOrWhiteSpace(DialogEditor.ToolName)
            || DialogEditor.ToolName == DialogGeneratedToolName)
        {
            DialogEditor.ToolName = uniqueToolName;
        }
        DialogGeneratedToolName = uniqueToolName;
    }

    private static string BuildManualSignatureWarning(string serviceName, string methodName) =>
        $"未能读取 {serviceName}#{methodName} 的方法签名（服务可能未注册元数据或元数据中心不可用）。请手动填写 Java 参数类型。";

    private void ResetManualSignatureState()
    {
        DialogRequiresManualSignature = false;
        DialogMetadataUnavailable = false;
        DialogManualNoParameters = false;
        DialogJavaParameterTypes = string.Empty;
        DialogGeneratedToolName = string.Empty;
    }

    private void OpenDebugDialog()
    {
        if (DialogEditor is null) return;

        DebugMethod = DialogEditor.Clone();
        DebugRequestJson = string.IsNullOrWhiteSpace(DialogEditor.ExampleRequestJson)
            ? "[]"
            : DialogEditor.ExampleRequestJson;
        DebugJavaParameterTypes = string.Join(", ", DialogEditor.ParameterTypes);
        DebugCanEditJavaParameterTypes = DialogRequiresManualSignature
            || DialogMetadataUnavailable
            || DialogEditor.ParameterTypesManuallyConfigured
            || string.IsNullOrWhiteSpace(DialogEditor.ReturnType);
        DebugOutput = null;
        DebugFailure = string.Empty;
    }

    private async Task SendDebugRequestAsync()
    {
        if (DebugMethod is null) return;

        IsDebugging = true;
        DebugOutput = null;
        DebugFailure = string.Empty;
        try
        {
            string javaParameterTypes = DebugCanEditJavaParameterTypes
                ? DebugJavaParameterTypes
                : string.Join(", ", DebugMethod.ParameterTypes);
            DebugOutput = await Gateway.DebugInvokeAsync(
                DebugMethod,
                DebugRequestJson,
                javaParameterTypes);
        }
        catch (Exception exception)
        {
            DebugFailure = exception.Message;
        }
        finally
        {
            IsDebugging = false;
        }
    }

    private void CloseDebugDialog()
    {
        DebugMethod = null;
        DebugRequestJson = "[]";
        DebugJavaParameterTypes = string.Empty;
        DebugCanEditJavaParameterTypes = false;
        DebugOutput = null;
        DebugFailure = string.Empty;
        IsDebugging = false;
    }

    private async Task SaveDialogConfigurationAsync()
    {
        if (DialogEditor is null) return;

        if (DialogMode == MethodDialogMode.Add)
        {
            McpDubboMethodConfiguration[] duplicateSignatures = Config.Methods
                .Where(method => method.ConfigurationKey == DialogEditor.ConfigurationKey)
                .ToArray();
            if (duplicateSignatures.Length > 0)
            {
                string existingTools = string.Join("、", duplicateSignatures.Select(method => method.ToolName));
                bool confirmed = await JS.InvokeAsync<bool>(
                    "confirm",
                    $"该精确 Dubbo 签名已配置 {duplicateSignatures.Length} 个 MCP 工具（{existingTools}）。继续保存会新增另一个调用相同 Dubbo 方法的 MCP 工具，是否继续？");
                if (!confirmed) return;
            }
        }

        IsSaving = true;
        try
        {
            if (DialogEditorParameters.Count > 0 || DialogRequiresManualSignature)
            {
                DialogEditor.InputSchemaJson = McpToolSchemaBuilder.BuildInputSchema(
                    DialogEditorParameters,
                    DialogEditor.ParameterGuidance);
            }

            int index = Config.Methods.FindIndex(method => method.Id == DialogEditor.Id);
            if (index >= 0) Config.Methods[index] = DialogEditor.Clone();
            else Config.Methods.Add(DialogEditor.Clone());
            await Gateway.SaveConfigurationAsync(Config);
            Config = Gateway.GetConfiguration();
            SetNotice(DialogEditor.Enabled ? "方法配置已保存并启用。" : "方法配置已保存。", false);
            CloseMethodDialog();
        }
        catch (Exception exception)
        {
            Config = Gateway.GetConfiguration();
            SetNotice(exception.Message, true);
        }
        finally
        {
            IsSaving = false;
        }
    }

    private async Task DeleteConfiguredMethodAsync(McpDubboMethodConfiguration method)
    {
        bool confirmed = await JS.InvokeAsync<bool>("confirm", $"确认删除工具 {method.ToolName} 的配置？");
        if (!confirmed) return;

        Config.Methods.RemoveAll(item => item.Id == method.Id);
        try
        {
            await Gateway.SaveConfigurationAsync(Config);
            Config = Gateway.GetConfiguration();
            if (DialogEditor?.Id == method.Id) CloseMethodDialog();
            SetNotice("方法 MCP 配置已删除。", false);
        }
        catch (Exception exception)
        {
            Config = Gateway.GetConfiguration();
            SetNotice(exception.Message, true);
        }
    }

    private void CloseMethodDialog()
    {
        CloseDebugDialog();
        DialogMode = MethodDialogMode.None;
        DialogEditor = null;
        DialogEditorParameters = [];
        DialogSignatures = [];
        ResetManualSignatureState();
        DialogSelectedService = null;
        IsDialogBusy = false;
    }

    private async Task RegenerateTokenAsync()
    {
        try
        {
            await Gateway.RegenerateAccessTokenAsync();
            Config = Gateway.GetConfiguration();
            ShowToken = true;
            SetNotice("访问令牌已重新生成，旧令牌立即失效。", false);
        }
        catch (Exception exception)
        {
            SetNotice(exception.Message, true);
        }
    }

    private IReadOnlyList<McpDubboMethodConfiguration> MethodConfigurations(
        DubboServiceItem service,
        string methodName) => Config.Methods
        .Where(method => NormalizeRegistryRoot(method.RegistryRootPath) == NormalizeRegistryRoot(service.RegistryRootPath)
            && method.ServiceName == service.Name
            && method.MethodName == methodName)
        .OrderBy(method => method.Signature, StringComparer.Ordinal)
        .ToArray();

    private static string NormalizeRegistryRoot(string? root) =>
        RegistryRootPaths.NormalizeRoot(root);

    private static string DisplayRegistryRoot(string? root) =>
        string.IsNullOrWhiteSpace(root) ? "—" : root.Trim();

    private static string FormatRecordTarget(McpCallRecord record) =>
        $"{DisplayRegistryRoot(record.RegistryRootPath)} · {record.ServiceName}#{record.MethodName}";

    private static string DisplayRemoteAddress(string? address) => address switch
    {
        "::1" => "本机（::1）",
        "127.0.0.1" => "本机（127.0.0.1）",
        _ => string.IsNullOrWhiteSpace(address) ? "未知来源" : address
    };

    private async Task CopyAsync(string value)
    {
        await JS.InvokeVoidAsync("dubboTester.copy", value);
        SetNotice("已复制到剪贴板。", false);
    }

    private void SetNotice(string message, bool isError)
    {
        Notice = message;
        NoticeIsError = isError;
        NoticeIsWarning = false;
    }

    private void SetWarning(string message)
    {
        Notice = message;
        NoticeIsError = false;
        NoticeIsWarning = true;
    }

    public void Dispose()
    {
        Gateway.Changed -= GatewayChanged;
    }

    private enum MethodDialogMode
    {
        None,
        Add,
        Edit,
        Details
    }
}
