<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="DubboNet" Version="2.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="DubboTester.Tests/**/*.cs" />
    <Content Remove="DubboTester.Tests/**" />
    <EmbeddedResource Remove="DubboTester.Tests/**" />
    <None Remove="DubboTester.Tests/**" />
  </ItemGroup>

</Project>
